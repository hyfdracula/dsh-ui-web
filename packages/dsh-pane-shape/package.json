{
  "name": "@captain1275/dsh-pane-shape",
  "description": "跨皮肤的面板形状层：三块区域统一内缩/圆角、右栏不再是实心平板、顶行对齐。只改形状，配色仍由皮肤决定。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.10.2",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
