{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    // Node globals and `node:` builtins resolve only through this seat: without
    // it every `import ... from 'node:fs'` reports TS2591 (the "install
    // @types/node" hint) even when @types/node is installed. Matches dsh-pet.
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src"]
}
