{
  "name": "@captain1275/dsh-path-links",
  "description": "本地路径链接化纯函数库：把文本里的 Windows 绝对路径切分成可点击 token（从 DSH fork ui-conversation/path-links.ts 迁移）。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
