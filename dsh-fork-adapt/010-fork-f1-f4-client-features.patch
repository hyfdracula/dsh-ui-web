+
+/* A Windows absolute path the text carries. Rendered inline like the plain runs
+   (a long path must be free to wrap rather than push the bubble wide), with the
+   link affordance carried by colour and a dotted underline instead of a chip, so
+   the sentence keeps its reading rhythm. Interactive only because ui-chat passed
+   an opener: no opener means this class is never applied. */
+.pathLink {
+  display: inline;
+  color: var(--dsw-alias-state-business-primary);
+  text-decoration: underline;
+  text-decoration-style: dotted;
+  text-underline-offset: 2px;
+  cursor: pointer;
+  /* A path has no spaces to break at, so allow a break anywhere inside it. */
+  word-break: break-all;
+}
+
+.pathLink:hover {
+  text-decoration-style: solid;
+}
+
+.pathLink:focus-visible {
+  outline: 2px solid var(--dsw-alias-state-business-primary);
+  outline-offset: 2px;
+  border-radius: 3px;
+}
