diff --git a/packages/client/ui-primitives/src/path-links.ts b/packages/client/ui-primitives/src/path-links.ts
new file mode 100644
index 0000000000000000000000000000000000000000..40e419829b0df4f2aeea264a3c2160d757be62a2
--- /dev/null
+++ b/packages/client/ui-primitives/src/path-links.ts
@@ -0,0 +1,75 @@
+/**
+ * Windows absolute path tokenizer for sent user text.
+ *
+ * Ported from this fork's earlier `ui-conversation/src/client/path-links.ts`
+ * (itself the same regex the `@captain1275/dsh-path-links` package exports), so
+ * the behaviour a log that already rendered as links keeps rendering the same
+ * way after the 0.1.5 client re-point. Lives inside ui-primitives rather than
+ * depending on the plugin package: the consumer here is an official package,
+ * and a pure regex split has no runtime surface worth a dependency.
+ *
+ * Two branches, deliberately different:
+ *   - a QUOTED path ("C:\my dir\file!.txt") is verbatim: it is what a user gets
+ *     from "copy as path", so nothing inside the quotes is trimmed;
+ *   - a BARE path sheds trailing sentence punctuation and stops at CJK prose,
+ *     because a Chinese sentence routinely runs on right after a path with no
+ *     separator ("见 C:\a\b.txt。" and "C:\data\报告.docx内容见上").
+ */
+
+/** One split result: a path to linkify, or ordinary text to keep as-is. */
+export type PathToken = { path: string } | { text: string }
+
+/** Trailing punctuation a bare path may pick up from prose (half- and full-width). */
+const TRAILING = /[.,;:!?)\]}…！？，。；：、）》】」』'"]+$/
+
+/**
+ * Windows absolute path recognition.
+ * - Quoted branch: `"C:\…"` / `"\\server\share\…"`, kept verbatim.
+ * - Bare branch: requires a word boundary before the drive letter (so `abcC:\x`
+ *   is not linkified mid-word), excludes CJK and full-width characters, and
+ *   excludes the `\\?\` / `\\.\` device prefixes.
+ */
+const PATH_RE = /"((?:[A-Za-z]:[\\/]|\\\\(?![?\\]))[^"\r\n]+)"|(?<![\p{L}\p{N}:_\\/])((?:[A-Za-z]:[\\/]|\\\\(?![?\\]))[^\s"'<>|*?\r\n　-〿㐀-䶿一-鿿豈-﫿＀-ｅ]+)/gu
+
+/**
+ * Split one text into ordered plain runs and path tokens.
+ * @param text - the logged model text of a message.
+ * @returns tokens covering the whole text, in order.
+ */
+export function splitPathTokens(text: string): PathToken[] {
+  const out: PathToken[] = []
+  let cursor = 0
+  let m: RegExpExecArray | null
+  PATH_RE.lastIndex = 0
+  while ((m = PATH_RE.exec(text)) !== null) {
+    const full = m[0]
+    const quoted = m[1]
+    const path = quoted !== undefined ? quoted : (m[2] ?? '').replace(TRAILING, '')
+    if (path.length === 0) continue
+    const pathStart = full.indexOf(path)
+    if (m.index > cursor) out.push({ text: text.slice(cursor, m.index) })
+    if (pathStart > 0) out.push({ text: full.slice(0, pathStart) })
+    out.push({ path })
+    const after = full.slice(pathStart + path.length)
+    if (after.length > 0) out.push({ text: after })
+    cursor = m.index + full.length
+  }
+  if (cursor < text.length) out.push({ text: text.slice(cursor) })
+  if (out.length === 0) out.push({ text })
+  return out
+}
+
+/**
+ * Locate the path tokens of one text as half-open offsets.
+ * @param text - the same text handed to {@link splitPathTokens}.
+ * @returns one range per path token, in order.
+ */
+export function pathTokenRanges(text: string): { start: number; end: number; path: string }[] {
+  const ranges: { start: number; end: number; path: string }[] = []
+  let cursor = 0
+  for (const token of splitPathTokens(text)) {
+    if ('path' in token) ranges.push({ start: cursor, end: cursor + token.path.length, path: token.path })
+    cursor += 'path' in token ? token.path.length : token.text.length
+  }
+  return ranges
+}
