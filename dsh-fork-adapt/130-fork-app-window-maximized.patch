+# Maximize the app window through Win32 once it exists. Chromium's own
+# `--start-maximized` is not reliable for `--app` windows, and the dedicated
+# profile would otherwise reopen at whatever placement it last saw.
+function Set-AppWindowMaximized {
+  param([int]$ProcessId, [int]$TimeoutSeconds = 20)
+  $signature = @'
+[DllImport("user32.dll")] public static extern bool ShowWindow(System.IntPtr hWnd, int nCmdShow);
+[DllImport("user32.dll")] public static extern bool IsZoomed(System.IntPtr hWnd);
+'@
+  if (-not ('Dsh.WindowNative' -as [type])) {
+    try { Add-Type -Namespace Dsh -Name WindowNative -MemberDefinition $signature -ErrorAction Stop } catch { return $false }
+  }
+  $deadline = (Get-Date).AddSeconds($TimeoutSeconds)
+  do {
+    $process = Get-Process -Id $ProcessId -ErrorAction SilentlyContinue
+    if ($null -ne $process) {
+      $process.Refresh()
+      $handle = $process.MainWindowHandle
+      if ($handle -ne [IntPtr]::Zero) {
+        try {
+          if (-not [Dsh.WindowNative]::IsZoomed($handle)) { [void][Dsh.WindowNative]::ShowWindow($handle, 3) }
+          Start-Sleep -Milliseconds 400
+          return [bool][Dsh.WindowNative]::IsZoomed($handle)
+        } catch { return $false }
+      }
+    }
+    Start-Sleep -Milliseconds 400
+  } while ((Get-Date) -lt $deadline)
+  return $false
+}
