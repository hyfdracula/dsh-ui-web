--- a/dsh-web-browser.ps1
+++ b/dsh-web-browser.ps1
@@ -21,6 +21,7 @@ param(
   [switch]$KeepPrevious,
   [switch]$NoLaunch,
   [switch]$Windowed,
+  [string]$Prefer = 'chrome',
   [int]$Port = 0,
   [int]$Width = 1500,
   [int]$Height = 950
@@ -39,14 +40,22 @@ if ($Port -le 0) {
   } else { $Port = 3080 }
 }
 
-function Get-BrowserPath {  $candidates = @(
-    (Join-Path ${env:ProgramFiles(x86)} 'Microsoft\Edge\Application\msedge.exe'),
-    (Join-Path $env:ProgramFiles 'Microsoft\Edge\Application\msedge.exe'),
-    (Join-Path ${env:ProgramFiles(x86)} 'Google\Chrome\Application\chrome.exe'),
+function Get-BrowserPath {
+  # Chrome first on purpose: the daily browser on this machine is Edge, and the
+  # GUI window must never be mistaken for it (nor disturb it). Either way the
+  # window runs from its own --user-data-dir.
+  param([string]$Prefer = 'chrome')
+  $chrome = @(
     (Join-Path $env:ProgramFiles 'Google\Chrome\Application\chrome.exe'),
+    (Join-Path ${env:ProgramFiles(x86)} 'Google\Chrome\Application\chrome.exe'),
     (Join-Path $env:LOCALAPPDATA 'Google\Chrome\Application\chrome.exe')
   )
-  foreach ($candidate in $candidates) {
+  $edge = @(
+    (Join-Path ${env:ProgramFiles(x86)} 'Microsoft\Edge\Application\msedge.exe'),
+    (Join-Path $env:ProgramFiles 'Microsoft\Edge\Application\msedge.exe')
+  )
+  $order = if ($Prefer -eq 'edge') { @($edge) + @($chrome) } else { @($chrome) + @($edge) }
+  foreach ($candidate in $order) {
     if ($candidate -and (Test-Path -LiteralPath $candidate -PathType Leaf)) { return $candidate }
   }
   return ''
@@ -115,12 +124,12 @@ if (-not $KeepPrevious) {
 
 if ($NoLaunch) { exit 0 }
 
-$browser = Get-BrowserPath
+$browser = Get-BrowserPath -Prefer $Prefer
 if ([string]::IsNullOrEmpty($browser)) {
-  # No Chromium browser found: fall back to the default handler (a normal tab).
-  Write-Host 'dsh-web-browser: no Edge/Chrome found; opening with the default browser'
-  Start-Process $Url
-  exit 0
+  # No Chromium browser at all: report instead of handing the URL to the default
+  # handler (that would put a bare DSH page into the everyday browser window).
+  Write-Host 'dsh-web-browser: no Edge/Chrome found; no window opened'
+  exit 1
 }
 
 New-Item -ItemType Directory -Force -Path $ProfileDir | Out-Null
