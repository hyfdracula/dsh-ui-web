diff --git a/dsh-web-host-launch.ps1 b/dsh-web-host-launch.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..7c7d7feea50162bf1d1ab78cf7a4b65df1ece168
--- /dev/null
+++ b/dsh-web-host-launch.ps1
@@ -0,0 +1,94 @@
+# Launch the built DSH Host without cmd.exe console windows or a console-backed
+# Node process. Called by the GUI-subsystem dsh-web-service-launch.vbs (and by
+# the restart worker through start-dsh-web.cmd).
+#
+# 0.1.5 notes:
+#   - profile/port/node come from the sibling dsh-web-service.json, so a cutover
+#     (web-next/3081 -> web/3080) is one file edit;
+#   - the Host runs with --no-open: this launcher and the restart worker own
+#     browser opening, exactly once;
+#   - node's stdout/stderr are redirected by cmd.exe INTO dsh-web.log /
+#     dsh-web.err.log. cmd's own file redirection is used deliberately: Node
+#     writes synchronously to a file handle, so the `dsh web: http://...?token=`
+#     line is on disk the moment it is printed, which is what the restart worker
+#     greps (0.1.5 answers an unauthenticated index request with 401, so the
+#     tokenized URL is the only thing a browser can use). The event-based drain
+#     (Register-ObjectEvent + BeginOutputReadLine) does not deliver under
+#     Windows PowerShell 5.1 while the script blocks in WaitForExit.
+#
+# Keep this file ASCII-only.
+[CmdletBinding()]
+param(
+  [string]$Profile = '',
+  [int]$Port = 0
+)
+
+$ErrorActionPreference = 'Stop'
+$root = $PSScriptRoot
+if ([string]::IsNullOrEmpty($root)) { $root = 'C:\Users\19161\deepseek-harness-next' }
+
+function Read-ServiceConfig {
+  $path = Join-Path $root 'dsh-web-service.json'
+  if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
+    throw "dsh-web-host-launch: service config not found: $path"
+  }
+  return (Get-Content -LiteralPath $path -Raw | ConvertFrom-Json)
+}
+
+$config = Read-ServiceConfig
+if ([string]::IsNullOrEmpty($Profile)) { $Profile = [string]$config.profile }
+if ($Port -le 0) { $Port = [int]$config.port }
+$node = [string]$config.node
+if ([string]::IsNullOrEmpty($node)) { $node = 'node' }
+
+$cliDir = Join-Path $root 'apps\cli'
+$stdout = Join-Path $root 'dsh-web.log'
+$stderr = Join-Path $root 'dsh-web.err.log'
+
+# Never start a second Host for the same port: an autostart task, a desktop
+# shortcut, and the restart worker all funnel through here.
+if ([bool](Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue)) {
+  Add-Content -LiteralPath $stdout -Value ("{0:yyyy-MM-dd HH:mm:ss} host already listening on {1}; launch skipped" -f (Get-Date), $Port)
+  exit 0
+}
+
+# One run per log: keep the previous tail, then start fresh so the token line
+# the restart worker greps always belongs to the host that is starting now.
+if (Test-Path -LiteralPath $stdout -PathType Leaf) {
+  Move-Item -LiteralPath $stdout -Destination (Join-Path $root 'dsh-web.previous.log') -Force
+}
+Set-Content -LiteralPath $stdout -Value ("{0:yyyy-MM-dd HH:mm:ss} launching host (profile {1}, port {2})" -f (Get-Date), $Profile, $Port)
+
+# cmd /d /s /c "…" keeps one command line: the /s form lets the outer quotes wrap
+# the whole command, so the inner quoted paths survive verbatim.
+$inner = '"' + $node + '" "lib/bin.js" --profile ' + $Profile + ' --port ' + $Port + ' --no-open'
+$inner += ' 1>>"' + $stdout + '" 2>>"' + $stderr + '"'
+
+$psi = [System.Diagnostics.ProcessStartInfo]::new()
+$psi.FileName = Join-Path $env:WINDIR 'System32\cmd.exe'
+$psi.Arguments = '/d /s /c "' + $inner + '"'
+$psi.WorkingDirectory = $cliDir
+$psi.UseShellExecute = $false
+$psi.CreateNoWindow = $true
+$process = [System.Diagnostics.Process]::Start($psi)
+if (-not $process) { throw 'dsh-web-host-launch: failed to start the built DSH Host.' }
+Add-Content -LiteralPath $stdout -Value ("{0:yyyy-MM-dd HH:mm:ss} host process started (cmd pid {1})" -f (Get-Date), $process.Id)
+$process.Dispose()
+
+# Wait for the HTTP layer so an interactive caller sees a live service, not a
+# half-bound port. 401 is the expected unauthenticated answer on 0.1.5.
+$deadline = (Get-Date).AddSeconds(90)
+$ready = $false
+while ((Get-Date) -lt $deadline) {
+  Start-Sleep -Milliseconds 500
+  try {
+    $response = Invoke-WebRequest ("http://127.0.0.1:$Port/") -UseBasicParsing -TimeoutSec 3
+    if ([int]$response.StatusCode -in 200, 303) { $ready = $true; break }
+  } catch {
+    $webResponse = $_.Exception.Response
+    if ($null -ne $webResponse -and [int]$webResponse.StatusCode -eq 401) { $ready = $true; break }
+  }
+}
+Add-Content -LiteralPath $stdout -Value ("{0:yyyy-MM-dd HH:mm:ss} launch wait finished (ready={1})" -f (Get-Date), $ready)
+if (-not $ready) { exit 1 }
+exit 0
diff --git a/dsh-web-restart-worker-launch.vbs b/dsh-web-restart-worker-launch.vbs
new file mode 100644
index 0000000000000000000000000000000000000000..e91c865e0693a0b3d5cd295acd8f0cdb9392b729
--- /dev/null
+++ b/dsh-web-restart-worker-launch.vbs
@@ -0,0 +1,19 @@
+' Hidden launcher for the one-shot DSH Web restart worker (0.1.5 checkout).
+' Scheduled Tasks starts wscript.exe (GUI subsystem), which then creates the
+' PowerShell worker with SW_HIDE. This avoids the transient console window that
+' appears when Task Scheduler starts powershell.exe directly.
+
+Option Explicit
+
+Dim shell, command, index, argument
+Set shell = CreateObject("WScript.Shell")
+
+command = "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File ""C:\Users\19161\deepseek-harness-next\dsh-web-restart.ps1"" -Worker"
+
+For index = 0 To WScript.Arguments.Count - 1
+  argument = WScript.Arguments(index)
+  command = command & " """ & argument & """"
+Next
+
+' intWindowStyle=0 (hidden), bWaitOnReturn=False (worker outlives launcher).
+shell.Run command, 0, False
diff --git a/dsh-web-restart.ps1 b/dsh-web-restart.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..6d0870a7835359ad1b03b8dabed4dab5f4f55f19
--- /dev/null
+++ b/dsh-web-restart.ps1
@@ -0,0 +1,199 @@
+# Restart the DSH web host (0.1.5 checkout) through a one-shot Scheduled Task.
+#
+# The worker is registered BEFORE the old host is stopped, so the command that
+# requested the restart survives the node process it replaces. Windows owns the
+# worker independently of the Host process.
+#
+# 0.1.5 differences from the 0.1.1 script this replaces:
+#   - readiness cannot be "HTTP 200 + /api/host.describe": the index route and
+#     every /api endpoint answer 401 unless the request carries the session
+#     cookie minted from the launch token. Readiness is therefore "the HTTP
+#     layer answers at all (401 expected) and /api responds (401 = the fence and
+#     the API route are mounted)".
+#   - the browser cannot simply open http://127.0.0.1:<port>/ (401). The worker
+#     reads the fresh `?token=` URL out of dsh-web.log, which the host launcher
+#     drains node's stdout into.
+#
+# Keep this file ASCII-only so it parses under Windows PowerShell 5.1.
+[CmdletBinding()]
+param(
+  [int]$Port = 0,
+  [int]$TimeoutSeconds = 90,
+  [switch]$Worker,
+  [switch]$NoBrowser,
+  [string]$TaskName
+)
+
+$ErrorActionPreference = 'Stop'
+$RepoRoot = 'C:\Users\19161\deepseek-harness-next'
+$StartCmd = Join-Path $RepoRoot 'start-dsh-web.cmd'
+$Log = Join-Path $RepoRoot 'dsh-restart-verify.log'
+$HostLog = Join-Path $RepoRoot 'dsh-web.log'
+$ServiceConfig = Join-Path $RepoRoot 'dsh-web-service.json'
+
+function Read-Service {
+  if (-not (Test-Path -LiteralPath $ServiceConfig -PathType Leaf)) { return $null }
+  return (Get-Content -LiteralPath $ServiceConfig -Raw | ConvertFrom-Json)
+}
+
+$service = Read-Service
+if ($Port -le 0) {
+  $Port = if ($null -ne $service) { [int]$service.port } else { 3080 }
+}
+$ProfileName = if ($null -ne $service) { [string]$service.profile } else { 'web' }
+$Url = "http://127.0.0.1:$Port/"
+
+function Write-Log {
+  param([string]$Message)
+  Add-Content -LiteralPath $Log -Value ("{0:yyyy-MM-dd HH:mm:ss} {1}" -f (Get-Date), $Message)
+}
+
+function Get-WebProcessIds {
+  $ids = @{}
+  Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue |
+    ForEach-Object { $ids[[int]$_.OwningProcess] = $true }
+  Get-CimInstance Win32_Process -Filter "Name='node.exe'" -ErrorAction SilentlyContinue |
+    Where-Object { $_.CommandLine -match ('(?i)(?:^|[\\/ ])lib[\\/]bin\.js.*--profile\s+' + [regex]::Escape($ProfileName) + '(?:\s|$)') } |
+    ForEach-Object { $ids[[int]$_.ProcessId] = $true }
+  return @($ids.Keys | ForEach-Object { [int]$_ })
+}
+
+function Wait-ListeningState {
+  param([bool]$Expected, [int]$Seconds = 20)
+  $deadline = (Get-Date).AddSeconds($Seconds)
+  do {
+    $listening = [bool](Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue)
+    if ($listening -eq $Expected) { return $true }
+    Start-Sleep -Milliseconds 250
+  } while ((Get-Date) -lt $deadline)
+  return $false
+}
+
+function Get-HttpStatus {
+  param([string]$Uri, [string]$Method = 'GET', [string]$Body = '')
+  try {
+    if ($Method -eq 'POST') {
+      $response = Invoke-WebRequest $Uri -Method Post -ContentType 'application/json' -Body $Body -UseBasicParsing -TimeoutSec 4
+    } else {
+      $response = Invoke-WebRequest $Uri -UseBasicParsing -TimeoutSec 4
+    }
+    return [int]$response.StatusCode
+  } catch {
+    $webResponse = $_.Exception.Response
+    if ($null -ne $webResponse) { return [int]$webResponse.StatusCode }
+    return -1
+  }
+}
+
+function Get-FreshTokenUrl {
+  # The host launcher rotates dsh-web.log per run, so the LAST token line in it
+  # belongs to the host we just started.
+  if (-not (Test-Path -LiteralPath $HostLog -PathType Leaf)) { return $null }
+  $matches = Select-String -LiteralPath $HostLog -Pattern 'http://127\.0\.0\.1:(\d+)/\?token=([A-Za-z0-9_\-]+)' -AllMatches
+  if ($null -eq $matches -or $matches.Count -eq 0) { return $null }
+  $last = $matches[$matches.Count - 1].Matches[0].Value
+  return $last
+}
+
+function Test-HostReady {
+  # 0.1.5: an unauthenticated index request answers 401 once the auth fence is
+  # live; an unauthenticated /api request answers 401 once the connection
+  # plugin has mounted the API route. Both must answer before the browser is
+  # handed the page (a 404 or no answer means the Loader is still composing).
+  $root = Get-HttpStatus -Uri $Url
+  if ($root -ne 401 -and $root -ne 200 -and $root -ne 303) { return $false }
+  $payload = '{"type":"client-request","rpcId":"restart-readiness-' + [guid]::NewGuid().ToString('N') + '","method":"settings/describe","payload":{}}'
+  $api = Get-HttpStatus -Uri ($Url.TrimEnd('/') + '/api/settings/describe') -Method POST -Body $payload
+  return ($api -eq 401 -or $api -eq 200)
+}
+
+function Register-RestartWorker {
+  param([string]$Name)
+  $launcher = Join-Path $RepoRoot 'dsh-web-restart-worker-launch.vbs'
+  if (-not (Test-Path -LiteralPath $launcher -PathType Leaf)) { throw "Restart worker launcher not found: $launcher" }
+  $actionArgs = '"' + $launcher + '" -TaskName "' + $Name + '" -Port ' + $Port + ' -TimeoutSeconds ' + $TimeoutSeconds
+  if ($NoBrowser) { $actionArgs += ' -NoBrowser' }
+  $action = New-ScheduledTaskAction -Execute 'wscript.exe' -Argument $actionArgs
+  $trigger = New-ScheduledTaskTrigger -Once -At (Get-Date).AddMinutes(1)
+  $principal = New-ScheduledTaskPrincipal -UserId (([System.Security.Principal.WindowsIdentity]::GetCurrent()).Name) -LogonType Interactive -RunLevel Limited
+  Register-ScheduledTask -TaskName $Name -Action $action -Trigger $trigger -Principal $principal -Force | Out-Null
+  Start-ScheduledTask -TaskName $Name
+}
+
+function Unregister-RestartWorker {
+  param([string]$Name)
+  if ($Name) { try { Unregister-ScheduledTask -TaskName $Name -Confirm:$false -ErrorAction SilentlyContinue } catch {} }
+}
+
+if (-not $Worker) {
+  try {
+    if (-not (Test-Path -LiteralPath $StartCmd -PathType Leaf)) { throw "Start script not found: $StartCmd" }
+    if (-not $TaskName) { $TaskName = 'DSH Web Restart ' + ([guid]::NewGuid().ToString('N').Substring(0, 8)) }
+    Write-Log ("registering restart worker '{0}' (port={1} profile={2} browser={3})" -f $TaskName, $Port, $ProfileName, (-not $NoBrowser))
+    Register-RestartWorker -Name $TaskName
+    Write-Log 'restart worker scheduled; caller may safely continue while the host restarts'
+    exit 0
+  } catch {
+    $message = $_.Exception.Message
+    try { Write-Log ("=== DSH Web restart scheduling failed: {0} ===" -f $message) } catch {}
+    Write-Error $message
+    exit 1
+  }
+}
+
+try {
+  if (-not $TaskName) { throw 'Worker mode requires -TaskName.' }
+  Write-Log ("=== DSH Web restart worker begin ({0}) ===" -f $TaskName)
+  Start-Sleep -Seconds 3
+
+  foreach ($id in (Get-WebProcessIds)) {
+    $process = Get-Process -Id $id -ErrorAction SilentlyContinue
+    if ($process) {
+      Write-Log ("stopping PID {0} ({1})" -f $process.Id, $process.ProcessName)
+      Stop-Process -Id $id -Force -ErrorAction SilentlyContinue
+    }
+  }
+  if (-not (Wait-ListeningState -Expected:$false -Seconds 20)) { throw "Port $Port is still listening after the old host was stopped." }
+
+  $psi = New-Object System.Diagnostics.ProcessStartInfo
+  $psi.FileName = Join-Path $env:WINDIR 'System32\cmd.exe'
+  $psi.Arguments = '/d /c call "' + $StartCmd + '"'
+  $psi.WorkingDirectory = $RepoRoot
+  $psi.UseShellExecute = $false
+  $psi.CreateNoWindow = $true
+  $child = [System.Diagnostics.Process]::Start($psi)
+  if (-not $child) { throw 'Failed to create the detached start process.' }
+  $childId = $child.Id
+  $child.Dispose()
+  Write-Log ("started detached cmd PID {0}" -f $childId)
+
+  $deadline = (Get-Date).AddSeconds($TimeoutSeconds)
+  do {
+    if (Test-HostReady) { break }
+    Start-Sleep -Milliseconds 500
+  } while ((Get-Date) -lt $deadline)
+  if (-not (Test-HostReady)) { throw "DSH did not answer HTTP on $Url within $TimeoutSeconds seconds." }
+
+  $newIds = Get-WebProcessIds
+  Write-Log ("Host readiness {0} (401 = auth fence live) + /api/settings/describe -> OK; host PID(s): {1}" -f $Url, (($newIds -join ', ')))
+
+  if (-not $NoBrowser) {
+    $tokenUrl = Get-FreshTokenUrl
+    if ($null -ne $tokenUrl) {
+      Start-Process $tokenUrl
+      Write-Log ("browser opened at {0}" -f ($tokenUrl -replace 'token=[A-Za-z0-9_\-]+', 'token=***'))
+    } else {
+      Start-Process $Url
+      Write-Log ("no token line found in {0}; opened {1} (paste the token printed by the host log)" -f $HostLog, $Url)
+    }
+  }
+  Write-Log '=== DSH Web restart worker end: success ==='
+  exit 0
+} catch {
+  $message = $_.Exception.Message
+  try { Write-Log ("=== DSH Web restart worker failed: {0} ===" -f $message) } catch {}
+  Write-Error $message
+  exit 1
+} finally {
+  Unregister-RestartWorker -Name $TaskName
+}
