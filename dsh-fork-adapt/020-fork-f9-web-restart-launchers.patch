diff --git a/restart-dsh-web.ps1 b/restart-dsh-web.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..5cf840977a61ba247a6a7e44196c281561004559
--- /dev/null
+++ b/restart-dsh-web.ps1
@@ -0,0 +1,4 @@
+# Compatibility entry point for the DSH web restart command (0.1.5 checkout).
+# Keep one implementation so callers cannot drift into different behavior.
+& (Join-Path $PSScriptRoot 'dsh-web-restart.ps1') @args
+exit $LASTEXITCODE
diff --git a/start-dsh-web.cmd b/start-dsh-web.cmd
new file mode 100644
index 0000000000000000000000000000000000000000..74a98cd953732113250794cfe1ebf29f9ab67694
--- /dev/null
+++ b/start-dsh-web.cmd
@@ -0,0 +1,7 @@
+@echo off
+rem GUI-subsystem bootstrap for THIS checkout (0.1.5): the VBS launcher starts
+rem the built Host with hidden process creation, so no console window appears.
+rem The Host is launched with --no-open; browser opening is owned by the outer
+rem launcher or the restart worker, exactly once.
+wscript.exe "C:\Users\19161\deepseek-harness-next\dsh-web-service-launch.vbs"
+exit /b 0
