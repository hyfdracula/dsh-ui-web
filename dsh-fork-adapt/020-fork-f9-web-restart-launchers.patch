diff --git a/packages/host/web-restart/src/index.ts b/packages/host/web-restart/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..38667eec2c060d45c4b321486f9970515017504c
--- /dev/null
+++ b/packages/host/web-restart/src/index.ts
@@ -0,0 +1,126 @@
+/**
+ * Web-host restart command for the dsh web profile.
+ *
+ * `/restart` delegates to the checkout's proven one-shot Scheduled Task
+ * scheduler. Windows owns that worker independently of the Host process, so it
+ * survives the process it stops, relaunches `start-dsh-web.cmd`, waits for the
+ * complete Host readiness handshake, and opens the browser once.
+ *
+ * @module @deepseek-ai/dsh-host-web-restart
+ */
+
+import { spawnSync } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import type { Context } from '@deepseek-ai/cordis'
+import type { CommandInvocation, CommandResult } from '@deepseek-ai/dsh-commands'
+
+export const name = 'web-restart'
+export const inject = ['commands'] as const
+
+/** Deployment configuration for the restart command. */
+export interface Config {
+  /** TCP port the web host listens on. */
+  readonly port: number
+  /** Absolute path to the command file that boots the host (start-dsh-web.cmd). */
+  readonly startCmd: string
+  /** Working directory for the restart worker (the checkout root). */
+  readonly repoRoot: string
+  /** Optional log file the worker appends its lifecycle to. */
+  readonly verifyLog?: string
+  /** Whether the worker reopens the browser after the host returns. */
+  readonly openBrowser?: boolean
+  /** Seconds to wait for the old host's port to release. */
+  readonly stopSeconds?: number
+  /** Seconds to wait for HTTP 200 after relaunch. */
+  readonly waitSeconds?: number
+}
+
+const USAGE = 'Usage: /restart (no arguments)'
+
+/** Validate the deployment config at the configuration boundary. */
+export function resolveConfig(value: Config | undefined): Required<Pick<Config, 'port' | 'startCmd' | 'repoRoot' | 'openBrowser'>> & Config {
+  const port = value?.port ?? 3080
+  const startCmd = value?.startCmd
+  const repoRoot = value?.repoRoot
+  if (!Number.isInteger(port) || port <= 0 || port > 65535) {
+    throw new TypeError(`web-restart: port must be a valid TCP port, got ${String(port)}`)
+  }
+  if (typeof startCmd !== 'string' || startCmd.length === 0) {
+    throw new TypeError('web-restart: startCmd is required (absolute path to start-dsh-web.cmd)')
+  }
+  if (typeof repoRoot !== 'string' || repoRoot.length === 0) {
+    throw new TypeError('web-restart: repoRoot is required')
+  }
+  return {
+    port,
+    startCmd,
+    repoRoot,
+    openBrowser: value?.openBrowser ?? true,
+    ...(value?.verifyLog === undefined ? {} : { verifyLog: value.verifyLog }),
+    ...(value?.stopSeconds === undefined ? {} : { stopSeconds: value.stopSeconds }),
+    ...(value?.waitSeconds === undefined ? {} : { waitSeconds: value.waitSeconds }),
+  }
+}
+
+/** Schedule the proven Windows one-shot worker before this Host is stopped. */
+function schedule(config: Config): { kind: 'success'; text: string } {
+  if (!existsSync(config.startCmd)) {
+    throw new Error(`web-restart: start script not found: ${config.startCmd}`)
+  }
+  const restartScript = join(config.repoRoot, 'dsh-web-restart.ps1')
+  if (!existsSync(restartScript)) {
+    throw new Error(`web-restart: scheduler script not found: ${restartScript}`)
+  }
+  const args = [
+    '-NoProfile',
+    '-NonInteractive',
+    '-ExecutionPolicy',
+    'Bypass',
+    '-File',
+    restartScript,
+    '-Port',
+    String(config.port),
+    '-TimeoutSeconds',
+    String(config.waitSeconds ?? 60),
+  ]
+  if (config.openBrowser === false) args.push('-NoBrowser')
+  const result = spawnSync('powershell.exe', args, {
+    cwd: config.repoRoot,
+    windowsHide: true,
+    encoding: 'utf8',
+  })
+  if (result.error !== undefined) throw result.error
+  if (result.status !== 0) {
+    const detail = result.stderr.trim() || result.stdout.trim() || `exit code ${String(result.status)}`
+    throw new Error(`web-restart: failed to schedule Windows worker: ${detail}`)
+  }
+  return {
+    kind: 'success',
+    text: `Web host restart scheduled on port ${config.port}. The current process will stop;`
+      + ` Windows will relaunch the host${config.openBrowser ? ' and reopen the browser' : ''}.`,
+  }
+}
+
+/**
+ * Mount the `/restart` human command.
+ * @param ctx - context carrying the command registry.
+ * @param rawConfig - deployment configuration from the profile patch row.
+ */
+export function apply(ctx: Context, rawConfig?: Config): void {
+  const config = resolveConfig(rawConfig)
+  ctx.effect(function* () {
+    yield ctx.commands.register({
+      name: 'restart',
+      description: 'Restart the DSH web host (and reopen the browser)',
+      handler: (invocation: CommandInvocation): CommandResult => {
+        if (invocation.rawInput.trim().length > 0) return { kind: 'error', text: USAGE }
+        try {
+          return schedule(config)
+        } catch (error: unknown) {
+          return { kind: 'error', text: error instanceof Error ? error.message : String(error) }
+        }
+      },
+    })
+  }, 'web-restart lifecycle')
+}
diff --git a/packages/host/web-restart/src/worker.ts b/packages/host/web-restart/src/worker.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3ae7dc659aa12155c4fa81cf8877ed5d5fc72970
--- /dev/null
+++ b/packages/host/web-restart/src/worker.ts
@@ -0,0 +1,276 @@
+/**
+ * Detached web-host restart worker.
+ *
+ * Launched by the web-restart command as `node worker.js --config <json>`.
+ * The parent plugin process spawns this script detached BEFORE the old host is
+ * stopped, so the worker survives the process it replaces. It stops the port
+ * listener, relaunches `start-dsh-web.cmd`, waits for the HTTP layer to answer,
+ * reopens the browser (at the fresh tokenized URL, since 0.1.5 answers an
+ * unauthenticated index request with 401), and records the lifecycle in the
+ * verify log.
+ *
+ * @module @deepseek-ai/dsh-host-web-restart/worker
+ */
+
+import { execFile, spawn } from 'node:child_process'
+import { appendFile, readFile } from 'node:fs/promises'
+import { resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+/** The worker's frozen configuration, carried verbatim from the command. */
+export interface RestartWorkerConfig {
+  readonly port: number
+  /** Absolute path to the command file that boots the host. */
+  readonly startCmd: string
+  /** Working directory for relaunching the host. */
+  readonly repoRoot: string
+  /** Optional log file the worker appends its lifecycle to. */
+  readonly verifyLog?: string
+  /** Whether to reopen the browser after the host returns. */
+  readonly openBrowser: boolean
+  /** Seconds to wait for the old host's port to release. */
+  readonly stopSeconds: number
+  /** Seconds to wait for the HTTP layer to answer after relaunch. */
+  readonly waitSeconds: number
+  /**
+   * Host launcher log the worker reads the fresh tokenized URL from.
+   * Defaults to `<repoRoot>/dsh-web.log`.
+   */
+  readonly hostLog?: string
+}
+
+const DEFAULT_STOP_SECONDS = 20
+const DEFAULT_WAIT_SECONDS = 60
+
+/** Parse and validate the `--config <json>` argument. */
+export function parseWorkerConfig(argv: readonly string[]): RestartWorkerConfig {
+  const flag = argv.indexOf('--config')
+  if (flag === -1) throw new Error('web-restart worker requires --config <json>')
+  const raw = argv[flag + 1]
+  if (raw === undefined) throw new Error('web-restart worker requires a --config value')
+  let value: Record<string, unknown>
+  try {
+    value = JSON.parse(raw) as Record<string, unknown>
+  } catch (error: unknown) {
+    throw new Error(`web-restart worker received invalid --config JSON: ${String(error)}`)
+  }
+  const port = value.port
+  const startCmd = value.startCmd
+  const repoRoot = value.repoRoot
+  if (!Number.isInteger(port) || (port as number) <= 0 || (port as number) > 65535) {
+    throw new Error(`web-restart worker: port must be a valid TCP port, got ${String(port)}`)
+  }
+  if (typeof startCmd !== 'string' || startCmd.length === 0) {
+    throw new Error('web-restart worker: startCmd is required')
+  }
+  if (typeof repoRoot !== 'string' || repoRoot.length === 0) {
+    throw new Error('web-restart worker: repoRoot is required')
+  }
+  return {
+    port: port as number,
+    startCmd,
+    repoRoot,
+    ...(typeof value.verifyLog === 'string' && value.verifyLog.length > 0 ? { verifyLog: value.verifyLog } : {}),
+    ...(typeof value.hostLog === 'string' && value.hostLog.length > 0 ? { hostLog: value.hostLog } : {}),
+    openBrowser: Boolean(value.openBrowser ?? true),
+    stopSeconds: Number(value.stopSeconds ?? DEFAULT_STOP_SECONDS),
+    waitSeconds: Number(value.waitSeconds ?? DEFAULT_WAIT_SECONDS),
+  }
+}
+
+/** Extract LISTENING owning PIDs for one port from `netstat -ano -p tcp` output. */
+export function listeningPidsFromNetstat(text: string, port: number): number[] {
+  const pids = new Set<number>()
+  for (const line of text.split(/\r?\n/)) {
+    const tokens = line.trim().split(/\s+/)
+    if (tokens.length < 5) continue
+    if (tokens[3] !== 'LISTENING') continue
+    const local = tokens[1]
+    if (local === undefined || !local.endsWith(`:${port}`)) continue
+    const pid = Number(tokens[4])
+    if (Number.isInteger(pid) && pid > 0) pids.add(pid)
+  }
+  return [...pids]
+}
+
+/** Whether `netstat -ano -p tcp` output still shows a listener on the port. */
+export function hasListener(text: string, port: number): boolean {
+  return text.split(/\r?\n/).some((line) => {
+    const tokens = line.trim().split(/\s+/)
+    if (tokens.length >= 5 && tokens[3] === 'LISTENING') {
+      const local = tokens[1]
+      if (local !== undefined && local.endsWith(`:${port}`)) return true
+    }
+    return false
+  })
+}
+
+const sleep = (ms: number): Promise<void> => new Promise(resolve => { setTimeout(resolve, ms) })
+
+/** One `netstat -ano -p tcp` run. */
+function runNetstat(): Promise<string> {
+  return new Promise((resolve, reject) => {
+    execFile('netstat', ['-ano', '-p', 'tcp'], { windowsHide: true }, (error, stdout) => {
+      if (error !== null) reject(error)
+      else resolve(stdout)
+    })
+  })
+}
+
+/** Stop every process listening on the port. */
+async function stopListener(port: number): Promise<number> {
+  const pids = listeningPidsFromNetstat(await runNetstat(), port)
+  for (const pid of pids) {
+    await new Promise<void>((resolve) => {
+      execFile('taskkill', ['/F', '/PID', String(pid)], { windowsHide: true }, () => { resolve() })
+    })
+  }
+  return pids.length
+}
+
+/** Poll until the port stops (or starts) listening. */
+async function waitForPort(port: number, listening: boolean, seconds: number): Promise<boolean> {
+  const deadline = Date.now() + seconds * 1000
+  while (Date.now() < deadline) {
+    const current = hasListener(await runNetstat(), port)
+    if (current === listening) return true
+    await sleep(250)
+  }
+  return false
+}
+
+/**
+ * Poll the index route and one /api endpoint until the browser can connect.
+ *
+ * 0.1.5 authenticates every index and /api request: without the session cookie
+ * minted from the launch token both answer 401. That 401 is itself the
+ * readiness proof this worker needs — an HTTP answer means the web server is
+ * bound, and a 401 from `/api/settings/describe` means the connection plugin
+ * mounted the API route and its request fence, which is what a browser needs
+ * before it can load the shell. A 404 or a transport failure means the Loader
+ * is still composing.
+ */
+export async function isHostReady(port: number): Promise<boolean> {
+  const root = `http://127.0.0.1:${port}/`
+  const describe = `http://127.0.0.1:${port}/api/settings/describe`
+  try {
+    const page = await fetch(root)
+    if (page.status !== 200 && page.status !== 303 && page.status !== 401) return false
+    const response = await fetch(describe, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({
+        type: 'client-request',
+        rpcId: `restart-readiness-${Date.now()}-${Math.random().toString(36).slice(2)}`,
+        method: 'settings/describe',
+        payload: {},
+      }),
+    })
+    return response.status === 401 || response.status === 200
+  } catch {
+    return false
+  }
+}
+
+/**
+ * Read the newest `?token=` URL the host printed into its launcher log. The
+ * launcher rotates that log per run, so the last line belongs to this host; an
+ * unauthenticated browser would only ever see 401, which is why the worker
+ * opens the tokenized URL instead of the bare origin.
+ * @param hostLog - absolute path of the launcher log (undefined disables the read).
+ * @returns the tokenized URL, or undefined when the log has no token line yet.
+ */
+export async function readTokenUrl(hostLog: string | undefined): Promise<string | undefined> {
+  if (hostLog === undefined) return undefined
+  try {
+    const text = await readFile(hostLog, 'utf8')
+    const matches = [...text.matchAll(/http:\/\/127\.0\.0\.1:\d+\/\?token=[A-Za-z0-9_-]+/g)]
+    return matches.at(-1)?.[0]
+  } catch {
+    return undefined
+  }
+}
+
+/** Poll until the browser-facing Host handshake is ready. */
+async function waitForHttp(port: number, seconds: number): Promise<boolean> {
+  const deadline = Date.now() + seconds * 1000
+  while (Date.now() < deadline) {
+    if (await isHostReady(port)) return true
+    await sleep(500)
+  }
+  return false
+}
+
+/** Open the URL with the OS default browser. */
+function openBrowser(url: string): void {
+  execFile('cmd.exe', ['/c', 'start', '', url], { windowsHide: true }, () => {})
+}
+
+/** Append one timestamped lifecycle line to the verify log, when configured. */
+async function writeLog(verifyLog: string | undefined, message: string): Promise<void> {
+  if (verifyLog === undefined) return
+  const stamp = new Date().toISOString().replace('T', ' ').slice(0, 19)
+  await appendFile(verifyLog, `${stamp} ${message}\n`).catch(() => {})
+}
+
+/** The worker entry point. */
+async function main(): Promise<void> {
+  let config: RestartWorkerConfig
+  try {
+    config = parseWorkerConfig(process.argv)
+  } catch (error: unknown) {
+    console.error(error instanceof Error ? error.message : String(error))
+    process.exit(2)
+  }
+
+  await writeLog(config.verifyLog, '=== DSH Web restart worker begin ===')
+  await sleep(1500)
+
+  const stopped = await stopListener(config.port)
+  await writeLog(config.verifyLog, `stopped ${stopped} listener process(es) on port ${config.port}`)
+  if (!(await waitForPort(config.port, false, config.stopSeconds))) {
+    await writeLog(config.verifyLog, `port ${config.port} still listening after ${config.stopSeconds}s; aborting`)
+    process.exit(1)
+  }
+
+  const child = spawn('cmd.exe', ['/d', '/c', 'call', `"${config.startCmd}"`], {
+    cwd: config.repoRoot,
+    detached: true,
+    stdio: 'ignore',
+    windowsHide: true,
+  })
+  child.unref()
+  await writeLog(config.verifyLog, `started detached host via ${config.startCmd}`)
+
+  if (!(await waitForHttp(config.port, config.waitSeconds))) {
+    await writeLog(config.verifyLog, `host did not answer HTTP on port ${config.port} within ${config.waitSeconds}s`)
+    process.exit(1)
+  }
+  await writeLog(config.verifyLog, `Host readiness http://127.0.0.1:${config.port}/ (401 = auth fence) + /api/settings/describe -> OK`)
+
+  if (config.openBrowser) {
+    const tokenUrl = await readTokenUrl(config.hostLog ?? `${config.repoRoot}/dsh-web.log`)
+    if (tokenUrl !== undefined) {
+      openBrowser(tokenUrl)
+      await writeLog(config.verifyLog, `browser opened at ${tokenUrl.replace(/token=[A-Za-z0-9_-]+/, 'token=***')}`)
+    } else {
+      openBrowser(`http://127.0.0.1:${config.port}/`)
+      await writeLog(config.verifyLog, `no token line in the host log yet; opened http://127.0.0.1:${config.port}/`)
+    }
+  }
+  await writeLog(config.verifyLog, '=== DSH Web restart worker end: success ===')
+  process.exit(0)
+}
+
+/** Run as the worker entry only when invoked directly (`node worker.js ...`). */
+const isDirectRun = ((): boolean => {
+  const invoked = process.argv[1]
+  if (invoked === undefined) return false
+  try {
+    return resolve(invoked).toLowerCase() === resolve(fileURLToPath(import.meta.url)).toLowerCase()
+  } catch {
+    return false
+  }
+})()
+
+if (isDirectRun) void main()
