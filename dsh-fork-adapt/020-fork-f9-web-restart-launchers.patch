+import { describe, expect, it } from 'vitest'
+import {
+  hasListener, listeningPidsFromNetstat, parseWorkerConfig,
+} from '../src/worker.ts'
+
+const NETSTAT_SAMPLE = [
+  'Active Connections',
+  '',
+  '  Proto  Local Address          Foreign Address        State           PID',
+  '  TCP    127.0.0.1:3080         0.0.0.0:0              LISTENING       4012',
+  '  TCP    127.0.0.1:3080         127.0.0.1:51342        ESTABLISHED     4012',
+  '  TCP    127.0.0.1:3081         0.0.0.0:0              LISTENING       5123',
+  '  TCP    [::1]:3080             [::]:0                 LISTENING       6123',
+  '  TCP    0.0.0.0:445            0.0.0.0:0              LISTENING       4',
+].join('\n')
+
+describe('parseWorkerConfig', () => {
+  it('parses a complete config from --config JSON', () => {
+    const config = parseWorkerConfig([
+      'node', 'worker.js', '--config',
+      JSON.stringify({
+        port: 3080,
+        startCmd: 'C:\\start-dsh-web.cmd',
+        repoRoot: 'C:\\repo',
+        verifyLog: 'C:\\verify.log',
+        openBrowser: false,
+      }),
+    ])
+    expect(config).toEqual({
+      port: 3080,
+      startCmd: 'C:\\start-dsh-web.cmd',
+      repoRoot: 'C:\\repo',
+      verifyLog: 'C:\\verify.log',
+      openBrowser: false,
+      stopSeconds: 20,
+      waitSeconds: 60,
+    })
+  })
+
+  it('applies defaults for optional fields', () => {
+    const config = parseWorkerConfig([
+      'node', 'worker.js', '--config',
+      JSON.stringify({ port: 3080, startCmd: 'start.cmd', repoRoot: '.' }),
+    ])
+    expect(config.openBrowser).toBe(true)
+    expect(config.stopSeconds).toBe(20)
+    expect(config.waitSeconds).toBe(60)
+    expect(config.verifyLog).toBeUndefined()
+  })
+
+  it('rejects missing, malformed, or invalid configs', () => {
+    expect(() => parseWorkerConfig(['node', 'worker.js'])).toThrow(/--config/)
+    expect(() => parseWorkerConfig(['node', 'worker.js', '--config', '{bad'])).toThrow(/invalid --config/)
+    expect(() => parseWorkerConfig(['node', 'worker.js', '--config', '{"port":70000}'])).toThrow(/port/)
+    expect(() => parseWorkerConfig(['node', 'worker.js', '--config', '{"port":3080}'])).toThrow(/startCmd/)
+    expect(() => parseWorkerConfig([
+      'node', 'worker.js', '--config', '{"port":3080,"startCmd":"x"}',
+    ])).toThrow(/repoRoot/)
+  })
+})
+
+describe('netstat parsing', () => {
+  it('extracts only LISTENING owners of the exact port', () => {
+    expect(listeningPidsFromNetstat(NETSTAT_SAMPLE, 3080)).toEqual([4012, 6123])
+    expect(listeningPidsFromNetstat(NETSTAT_SAMPLE, 3081)).toEqual([5123])
+    expect(listeningPidsFromNetstat(NETSTAT_SAMPLE, 445)).toEqual([4])
+    expect(listeningPidsFromNetstat(NETSTAT_SAMPLE, 9999)).toEqual([])
+  })
+
+  it('detects whether a listener remains', () => {
+    expect(hasListener(NETSTAT_SAMPLE, 3080)).toBe(true)
+    expect(hasListener('', 3080)).toBe(false)
+  })
+})
