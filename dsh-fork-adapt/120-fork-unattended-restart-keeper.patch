+++ b/dsh-restart-agent.vbs
@@ -0,0 +1,16 @@
+' DSH restart-agent bridge.
+' The repeating Scheduled Task runs exactly this file: wscript.exe starts
+' PowerShell with window style 0 (SW_HIDE at process creation), so a cycle that
+' runs every couple of minutes never flashes a console window.
+'
+' Usage:
+'   wscript.exe dsh-restart-agent.vbs          -> one cycle, hidden
+'
+' Keep this file ASCII-only.
+
+Option Explicit
+
+Dim shell, cmd
+Set shell = CreateObject("WScript.Shell")
+cmd = "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File ""C:\Users\19161\deepseek-harness-next\dsh-restart-agent.ps1"" -Once"
+shell.Run cmd, 0, False
