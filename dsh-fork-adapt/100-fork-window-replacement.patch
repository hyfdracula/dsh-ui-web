diff --git a/dsh-quick-send.ps1 b/dsh-quick-send.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..d5aa2dd59b7732bf7a1541980cc3efe6c7287932
--- /dev/null
+++ b/dsh-quick-send.ps1
@@ -0,0 +1,281 @@
+# dsh-quick-send.ps1 -- the "quick send" box for the DSH web Host.
+#
+# A small always-on-top window: type a message, press Enter, and it goes into a
+# Session through the Host's own API (no browser interaction needed):
+#
+#   * "new Session @ <workspace>" -- session/create { workspaceId } then
+#     session/prompt with the typed text;
+#   * "continue the most recent Session" -- session/prompt into the newest
+#     Session the Host reports (mode 'queue', so an in-flight turn keeps it).
+#
+# Auth: the Host fences every /api route behind the cookie minted from the
+# launch token, so the script asks dsh-web-open.ps1 -NoBrowser for the current
+# tokenized URL (that call also starts the Host when it is down) and exchanges
+# it for a session cookie.
+#
+# UI strings live in dsh-quick-send.strings.json (UTF-8, no BOM) because this
+# file stays ASCII-only so Windows PowerShell 5.1 parses it reliably.
+#
+# Keep this file ASCII-only.
+[CmdletBinding()]
+param(
+  [switch]$SelfTest,
+  [string]$SelfTestTarget = 'new-first',
+  [string]$SelfTestText = 'quick-send self test'
+)
+
+$ErrorActionPreference = 'Continue'
+$root = $PSScriptRoot
+if ([string]::IsNullOrEmpty($root)) { $root = 'C:\Users\19161\deepseek-harness-next' }
+
+Add-Type -AssemblyName System.Windows.Forms
+Add-Type -AssemblyName System.Drawing
+
+# ---- strings ---------------------------------------------------------------
+$stringsPath = Join-Path $root 'dsh-quick-send.strings.json'
+$defaults = [ordered]@{
+  title = 'DSH quick send'
+  targetLabel = 'Send to'
+  newInWorkspace = 'New Session @ {0}'
+  continueLatest = 'Continue the most recent Session'
+  send = 'Send (Enter)'
+  close = 'Close (Esc)'
+  hint = 'Enter sends, Shift+Enter adds a line, Esc closes'
+  sending = 'Sending...'
+  sent = 'Sent -> {0}'
+  failed = 'Send failed: {0}'
+  empty = 'Nothing to send'
+  starting = 'Starting the Host...'
+  noTarget = 'No target available'
+}
+# Copy rather than alias: assigning an ordered dictionary shares the instance, and
+# the load loop writes into $S while iterating the defaults.
+$S = [ordered]@{}
+foreach ($key in $defaults.Keys) { $S[$key] = $defaults[$key] }
+if (Test-Path -LiteralPath $stringsPath -PathType Leaf) {
+  try {
+    $loaded = Get-Content -LiteralPath $stringsPath -Raw -Encoding UTF8 | ConvertFrom-Json
+    foreach ($key in @($defaults.Keys)) {
+      if ($null -ne $loaded.$key -and [string]$loaded.$key -ne '') { $S[$key] = [string]$loaded.$key }
+    }
+  } catch {
+    Write-Host ("dsh-quick-send: strings file unreadable ({0}); using defaults" -f $_.Exception.Message)
+  }
+}
+
+# ---- host access -----------------------------------------------------------
+function Get-DshBaseUrl {
+  $opener = Join-Path $root 'dsh-web-open.ps1'
+  if (-not (Test-Path -LiteralPath $opener -PathType Leaf)) { return '' }
+  $url = (& powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $opener -NoBrowser) | Select-Object -Last 1
+  return ([string]$url).Trim()
+}
+
+function New-DshWebSession {
+  param([string]$TokenUrl)
+  $session = New-Object Microsoft.PowerShell.Commands.WebRequestSession
+  Invoke-WebRequest -Uri $TokenUrl -WebSession $session -UseBasicParsing -TimeoutSec 15 | Out-Null
+  return $session
+}
+
+function Invoke-DshRpc {
+  param(
+    [Parameter(Mandatory = $true)][string]$Endpoint,
+    [Parameter(Mandatory = $true)][string]$ArgsJson,
+    $WebSession
+  )
+  $rpcId = [guid]::NewGuid().ToString()
+  $body = '{"type":"client-request","rpcId":"' + $rpcId + '","method":"' + $Endpoint + '","payload":{"args":' + $ArgsJson + '}}'
+  $port = ([uri]$script:BaseUrl).Port
+  $response = Invoke-RestMethod -Uri ("http://127.0.0.1:$port/api/" + $Endpoint) -Method Post -Body $body `
+    -ContentType 'application/json' -WebSession $WebSession -TimeoutSec 30
+  if ($response.result.ok -ne $true) {
+    $error = $response.result.error
+    throw ("{0}: {1}" -f $error.code, $error.message)
+  }
+  return $response.result.value
+}
+
+function Get-WorkspaceChoices {
+  $store = Join-Path $env:USERPROFILE '.dsh\storages\workspace.json'
+  $choices = @()
+  if (Test-Path -LiteralPath $store -PathType Leaf) {
+    try {
+      $state = Get-Content -LiteralPath $store -Raw -Encoding UTF8 | ConvertFrom-Json
+      foreach ($id in $state.global.workspaceIds) {
+        $record = $state.tables.workspaces.$id
+        if ($null -eq $record) { continue }
+        $choices += [pscustomobject]@{ kind = 'workspace'; workspaceId = $id; title = [string]$record.title; path = [string]$record.path }
+      }
+    } catch { }
+  }
+  return $choices
+}
+
+# ---- one send --------------------------------------------------------------
+function Send-QuickMessage {
+  param(
+    [Parameter(Mandatory = $true)][string]$Text,
+    [Parameter(Mandatory = $true)]$Target,
+    $WebSession
+  )
+  $sessionId = $null
+  if ($Target.kind -eq 'workspace') {
+    $created = Invoke-DshRpc -Endpoint 'session/create' -ArgsJson ('{"request":{"workspaceId":"' + $Target.workspaceId + '"}}') -WebSession $WebSession
+    $sessionId = [string]$created.sessionId
+  } else {
+    $list = Invoke-DshRpc -Endpoint 'session/list' -ArgsJson '{"_request":{}}' -WebSession $WebSession
+    $newest = $list.items | Sort-Object -Property updatedAt -Descending | Select-Object -First 1
+    if ($null -eq $newest) { throw $S.noTarget }
+    $sessionId = [string]$newest.sessionId
+  }
+  $requestId = [guid]::NewGuid().ToString()
+  $textJson = ($Text | ConvertTo-Json -Compress)
+  $argsJson = '{"request":{"requestId":"' + $requestId + '","sessionId":"' + $sessionId + '","mode":"queue","content":[{"type":"text","text":' + $textJson + '}]}}'
+  Invoke-DshRpc -Endpoint 'session/prompt' -ArgsJson $argsJson -WebSession $WebSession | Out-Null
+  return $sessionId
+}
+
+# ---- self test (no UI) -----------------------------------------------------
+if ($SelfTest) {
+  $script:BaseUrl = Get-DshBaseUrl
+  if ([string]::IsNullOrEmpty($script:BaseUrl)) { Write-Error 'no Host URL'; exit 1 }
+  $web = New-DshWebSession -TokenUrl $script:BaseUrl
+  $choices = Get-WorkspaceChoices
+  $target = if ($SelfTestTarget -eq 'latest') {
+    [pscustomobject]@{ kind = 'latest' }
+  } else {
+    $choices | Select-Object -First 1
+  }
+  try {
+    $sessionId = Send-QuickMessage -Text $SelfTestText -Target $target -WebSession $web
+    Write-Host ("self test OK -> {0}" -f $sessionId)
+    exit 0
+  } catch {
+    Write-Host ("self test FAILED: {0}" -f $_.Exception.Message)
+    exit 1
+  }
+}
+
+# ---- UI --------------------------------------------------------------------
+$script:BaseUrl = ''
+$script:WebSession = $null
+$script:Workspaces = @()
+
+$form = New-Object System.Windows.Forms.Form
+$form.Text = $S.title
+$form.Size = New-Object System.Drawing.Size(520, 300)
+$form.StartPosition = 'CenterScreen'
+$form.TopMost = $true
+$form.MinimizeBox = $false
+$form.KeyPreview = $true
+
+$targetLabel = New-Object System.Windows.Forms.Label
+$targetLabel.Text = $S.targetLabel
+$targetLabel.Location = New-Object System.Drawing.Point(14, 14)
+$targetLabel.AutoSize = $true
+$form.Controls.Add($targetLabel)
+
+$combo = New-Object System.Windows.Forms.ComboBox
+$combo.DropDownStyle = 'DropDownList'
+$combo.Location = New-Object System.Drawing.Point(14, 36)
+$combo.Size = New-Object System.Drawing.Size(478, 24)
+$form.Controls.Add($combo)
+
+$box = New-Object System.Windows.Forms.TextBox
+$box.Multiline = $true
+$box.AcceptsReturn = $true
+$box.ScrollBars = 'Vertical'
+$box.Location = New-Object System.Drawing.Point(14, 68)
+$box.Size = New-Object System.Drawing.Size(478, 130)
+$form.Controls.Add($box)
+
+$sendButton = New-Object System.Windows.Forms.Button
+$sendButton.Text = $S.send
+$sendButton.Location = New-Object System.Drawing.Point(14, 206)
+$sendButton.Size = New-Object System.Drawing.Size(150, 28)
+$form.Controls.Add($sendButton)
+
+$closeButton = New-Object System.Windows.Forms.Button
+$closeButton.Text = $S.close
+$closeButton.Location = New-Object System.Drawing.Point(174, 206)
+$closeButton.Size = New-Object System.Drawing.Size(120, 28)
+$form.Controls.Add($closeButton)
+
+$status = New-Object System.Windows.Forms.Label
+$status.Location = New-Object System.Drawing.Point(14, 238)
+$status.Size = New-Object System.Drawing.Size(478, 20)
+$status.Text = $S.hint
+$form.Controls.Add($status)
+
+function Initialize-DshTargets {
+  $script:Workspaces = Get-WorkspaceChoices
+  $combo.Items.Clear()
+  foreach ($workspace in $script:Workspaces) {
+    [void]$combo.Items.Add(($S.newInWorkspace -f $workspace.title))
+  }
+  [void]$combo.Items.Add($S.continueLatest)
+  if ($combo.Items.Count -gt 0) { $combo.SelectedIndex = 0 }
+}
+
+function Connect-DshHost {
+  if (-not [string]::IsNullOrEmpty($script:BaseUrl) -and $null -ne $script:WebSession) { return $true }
+  $form.Cursor = [System.Windows.Forms.Cursors]::WaitCursor
+  $status.Text = $S.starting
+  [System.Windows.Forms.Application]::DoEvents()
+  try {
+    $script:BaseUrl = Get-DshBaseUrl
+    if ([string]::IsNullOrEmpty($script:BaseUrl)) { throw 'no URL' }
+    $script:WebSession = New-DshWebSession -TokenUrl $script:BaseUrl
+    return $true
+  } catch {
+    $status.Text = ($S.failed -f $_.Exception.Message)
+    $script:WebSession = $null
+    return $false
+  } finally {
+    $form.Cursor = [System.Windows.Forms.Cursors]::Default
+  }
+}
+
+function Invoke-Send {
+  $text = $box.Text
+  if ([string]::IsNullOrWhiteSpace($text)) { $status.Text = $S.empty; return }
+  if (-not (Connect-DshHost)) { return }
+  $status.Text = $S.sending
+  [System.Windows.Forms.Application]::DoEvents()
+  try {
+    $index = $combo.SelectedIndex
+    $target = if ($index -ge 0 -and $index -lt $script:Workspaces.Count) {
+      $script:Workspaces[$index]
+    } else {
+      [pscustomobject]@{ kind = 'latest' }
+    }
+    $sessionId = Send-QuickMessage -Text $text -Target $target -WebSession $script:WebSession
+    $status.Text = ($S.sent -f $sessionId)
+    $box.Clear()
+  } catch {
+    $status.Text = ($S.failed -f $_.Exception.Message)
+    $script:WebSession = $null
+  }
+}
+
+$sendButton.Add_Click({ Invoke-Send })
+$closeButton.Add_Click({ $form.Close() })
+$box.Add_KeyDown({
+  param($sender, $event)
+  if ($event.KeyCode -eq [System.Windows.Forms.Keys]::Return -and -not $event.Shift) {
+    $event.SuppressKeyPress = $true
+    Invoke-Send
+  }
+})
+$form.Add_KeyDown({
+  param($sender, $event)
+  if ($event.KeyCode -eq [System.Windows.Forms.Keys]::Escape) { $form.Close() }
+})
+$form.Add_Shown({
+  Initialize-DshTargets
+  Connect-DshHost | Out-Null
+  $box.Focus()
+})
+
+[void]$form.ShowDialog()
