+' DSH quick-send bridge.
+' wscript.exe (GUI subsystem) starts the WinForms dialog through PowerShell with
+' window style 0, so no console window flashes next to the dialog.
+'
+' Usage:
+'   wscript.exe dsh-quick-send.vbs
+'   (the restart worker launches exactly this after a restart)
+
+Option Explicit
+
+Dim shell, cmd
+Set shell = CreateObject("WScript.Shell")
+cmd = "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File ""C:\Users\19161\deepseek-harness-next\dsh-quick-send.ps1"""
+shell.Run cmd, 0, False
diff --git a/dsh-web-browser.ps1 b/dsh-web-browser.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..e62bc3cd1bf873815cc35dc148908081f3ceed4d
--- /dev/null
+++ b/dsh-web-browser.ps1
@@ -0,0 +1,112 @@
+# dsh-web-browser.ps1 -- one owner for "show the DSH GUI in a browser".
+#
+# Why this exists: the desktop entry and the restart worker both need to show a
+# freshly minted tokenized URL. Opening it as a normal tab leaves the previous
+# (now unauthenticated) tab behind every restart, so the browser accumulates
+# dead DSH tabs. This script instead owns ONE dedicated app-mode window:
+#
+#   1. every process started from our own user-data-dir / --app URL is closed
+#      (the stale window disappears instead of lingering);
+#   2. a new app window is opened at the fresh token URL and its process id is
+#      recorded in dsh-web-app.pid for the next round.
+#
+# The dedicated `--user-data-dir` keeps the token cookie out of the daily
+# browsing profile and makes "which processes are ours" decidable.
+#
+# Keep this file ASCII-only so it parses under Windows PowerShell 5.1.
+[CmdletBinding()]
+param(
+  [Parameter(Mandatory = $true)][string]$Url,
+  [string]$ProfileDir = '',
+  [switch]$KeepPrevious,
+  [switch]$NoLaunch,
+  [int]$Port = 0,
+  [int]$Width = 1500,
+  [int]$Height = 950
+)
+
+$ErrorActionPreference = 'Continue'
+$root = $PSScriptRoot
+if ([string]::IsNullOrEmpty($root)) { $root = 'C:\Users\19161\deepseek-harness-next' }
+
+if ([string]::IsNullOrEmpty($ProfileDir)) { $ProfileDir = Join-Path $root '.dsh-browser-profile' }
+$pidFile = Join-Path $root 'dsh-web-app.pid'
+if ($Port -le 0) {
+  $configPath = Join-Path $root 'dsh-web-service.json'
+  if (Test-Path -LiteralPath $configPath -PathType Leaf) {
+    $Port = [int](Get-Content -LiteralPath $configPath -Raw | ConvertFrom-Json).port
+  } else { $Port = 3080 }
+}
+
+function Get-BrowserPath {
+  $candidates = @(
+    (Join-Path ${env:ProgramFiles(x86)} 'Microsoft\Edge\Application\msedge.exe'),
+    (Join-Path $env:ProgramFiles 'Microsoft\Edge\Application\msedge.exe'),
+    (Join-Path ${env:ProgramFiles(x86)} 'Google\Chrome\Application\chrome.exe'),
+    (Join-Path $env:ProgramFiles 'Google\Chrome\Application\chrome.exe'),
+    (Join-Path $env:LOCALAPPDATA 'Google\Chrome\Application\chrome.exe')
+  )
+  foreach ($candidate in $candidates) {
+    if ($candidate -and (Test-Path -LiteralPath $candidate -PathType Leaf)) { return $candidate }
+  }
+  return ''
+}
+
+# Every browser process that belongs to this launcher family: it either carries
+# our user-data-dir (any child of the app window) or was recorded in the pid file.
+function Get-OwnedBrowserProcessIds {
+  $ids = @{}
+  if (Test-Path -LiteralPath $pidFile -PathType Leaf) {
+    foreach ($line in (Get-Content -LiteralPath $pidFile -ErrorAction SilentlyContinue)) {
+      $parsed = 0
+      if ([int]::TryParse(([string]$line).Trim(), [ref]$parsed) -and $parsed -gt 0) { $ids[$parsed] = $true }
+    }
+  }
+  $needle = $ProfileDir.ToLowerInvariant()
+  Get-CimInstance Win32_Process -Filter "Name='msedge.exe' or Name='chrome.exe'" -ErrorAction SilentlyContinue |
+    Where-Object { $_.CommandLine -and $_.CommandLine.ToLowerInvariant().Contains($needle) } |
+    ForEach-Object { $ids[[int]$_.ProcessId] = $true }
+  return @($ids.Keys | ForEach-Object { [int]$_ })
+}
+
+if (-not $KeepPrevious) {
+  $closed = 0
+  foreach ($id in (Get-OwnedBrowserProcessIds)) {
+    $process = Get-CimInstance Win32_Process -Filter "ProcessId=$id" -ErrorAction SilentlyContinue
+    if ($null -eq $process) { continue }
+    if ($process.Name -notin @('msedge.exe', 'chrome.exe')) { continue }
+    Stop-Process -Id $id -Force -ErrorAction SilentlyContinue
+    $closed += 1
+  }
+  if (Test-Path -LiteralPath $pidFile -PathType Leaf) { Remove-Item -LiteralPath $pidFile -Force -ErrorAction SilentlyContinue }
+  Write-Host ("dsh-web-browser: closed {0} previous app-window process(es)" -f $closed)
+}
+
+if ($NoLaunch) { exit 0 }
+
+$browser = Get-BrowserPath
+if ([string]::IsNullOrEmpty($browser)) {
+  # No Chromium browser found: fall back to the default handler (a normal tab).
+  Write-Host 'dsh-web-browser: no Edge/Chrome found; opening with the default browser'
+  Start-Process $Url
+  exit 0
+}
+
+New-Item -ItemType Directory -Force -Path $ProfileDir | Out-Null
+$arguments = @(
+  "--app=$Url",
+  "--user-data-dir=$ProfileDir",
+  '--no-first-run',
+  '--no-default-browser-check',
+  '--disable-features=msEdgeSidebarV2',
+  ("--window-size={0},{1}" -f $Width, $Height)
+)
+$child = Start-Process -FilePath $browser -ArgumentList $arguments -PassThru
+if ($null -ne $child) {
+  Set-Content -LiteralPath $pidFile -Value ([string]$child.Id) -Encoding ascii
+  Write-Host ("dsh-web-browser: opened app window pid {0} at {1}" -f $child.Id, ($Url -replace 'token=[A-Za-z0-9_\-]+', 'token=***'))
+} else {
+  Write-Host 'dsh-web-browser: failed to start the browser'
+  exit 1
+}
+exit 0
diff --git a/dsh-web-open.ps1 b/dsh-web-open.ps1
