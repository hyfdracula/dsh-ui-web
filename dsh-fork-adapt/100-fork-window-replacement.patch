+#     token printed by the Host (`dsh web: http://.../?token=...`) is the only URL
 #     a browser can use, and every start mints a new one. This script therefore
 #     reads the token line out of dsh-web.log after readiness.
 #   - profile/port/node come from the sibling dsh-web-service.json, so a
@@ -61,7 +61,7 @@ function Test-HostReady {
 }
 
 # The tokenized URL of the Host this config points at. Only lines for THIS port
-# count — another checkout's Host can have written the same shared log.
+# count - another checkout's Host can have written the same shared log.
 #
 # Search order: the current Host's log, then the per-port log a Host started
 # with its own redirection writes (the cutover's interim/foreground starts did
@@ -113,5 +113,12 @@ if ($NoBrowser) {
   exit 0
 }
 if ($config.openBrowser -eq $false) { exit 0 }
-Start-Process $url
+# One owner for "show the GUI": dsh-web-browser.ps1 closes the previous DSH app
+# window (a stale token URL is useless) and opens this one at the fresh token.
+$browser = Join-Path $root 'dsh-web-browser.ps1'
+if (Test-Path -LiteralPath $browser -PathType Leaf) {
+  & powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $browser -Url $url -Port $port
+} else {
+  Start-Process $url
+}
