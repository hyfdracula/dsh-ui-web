+/**
+ * Content-addressed, owner-private local storage for generic file attachments.
+ *
+ * 逻辑已单源到 @captain1275/dsh-file-attachment 插件包（dsh-ui-web），此处仅
+ * 做薄委托：对外签名（validateFile/saveFile/readFile + root/limits 参数）保持
+ * 不变，内部构造插件包的 FileAttachmentStore 并转发。错误码、ref 形状、
+ * 无限哨兵默认与 name 净化行为与插件包一致（插件包由 fork 逻辑迁移而来）。
+ * @module dsh-attachment-local/file-store
+ */
+
+import type { FileAttachmentLimits, FileAttachmentRef, SaveFileAttachment, StoredFileAttachment } from '@deepseek-ai/dsh-attachment'
+import { FileAttachmentStore, validateFileSync } from '@captain1275/dsh-file-attachment'
+
+/**
+ * Run the admission policy for one generic file without touching storage.
+ * 同步抛错语义（attachment-local 的 validateFile 同步调用本函数）。
+ * @param input - encoded bytes and declared metadata.
+ * @param limits - resolved storage policy.
+ */
+export function validateFile(input: SaveFileAttachment, limits: FileAttachmentLimits): void {
+  validateFileSync(input, limits)
+}
+
+/**
+ * Save and verify immutable file bytes below a versioned attachment root.
+ * @param root - absolute `DSH_HOME/attachments/v1` root.
+ * @param input - encoded bytes and declared metadata.
+ * @param limits - resolved storage policy.
+ * @returns durable content-addressed reference.
+ */
+export async function saveFile(root: string, input: SaveFileAttachment, limits: FileAttachmentLimits): Promise<FileAttachmentRef> {
+  return new FileAttachmentStore(root, limits).saveFile(input)
+}
+
+/**
+ * Read and verify one content-addressed generic file.
+ * @param root - absolute `DSH_HOME/attachments/v1` root.
+ * @param ref - reference recorded in the session log.
+ * @param signal - optional cancellation for filesystem and verification work.
+ * @returns verified bytes and reference.
+ */
+export async function readFile(
+  root: string,
+  ref: FileAttachmentRef,
+  signal?: AbortSignal,
+): Promise<StoredFileAttachment> {
+  return new FileAttachmentStore(root).readFile(ref, signal)
+}
