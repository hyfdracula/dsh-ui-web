diff --git a/packages/llm/llm-pi-ai/tests/glm-normalizer.spec.ts b/packages/llm/llm-pi-ai/tests/glm-normalizer.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..769a3a192e9a40c4511adc5c792cb2a6666a7fa3
--- /dev/null
+++ b/packages/llm/llm-pi-ai/tests/glm-normalizer.spec.ts
@@ -0,0 +1,171 @@
+/**
+ * The GLM stream-normalizer seam on the pi-ai adapter: the gateway folds
+ * (`@deepseek-ai/dsh-llm-glm-normalize`) apply per provider route, a profile can
+ * disable or alias them, and caller-supplied normalizers compose after them.
+ *
+ * Ported from the 0.1.1 fork's `convert.spec.ts` additions; the folds are
+ * addressed through `toStreamChunks`' trailing {@link StreamFoldOptions} object
+ * here, because 0.1.5 already spends two positional parameters on the caller
+ * signal and the requested model.
+ */
+import { describe, expect, it } from 'vitest'
+import type { AssistantMessage, AssistantMessageEvent, Usage } from '@earendil-works/pi-ai'
+import { Config } from '../src/config.ts'
+import { toStreamChunks } from '../src/stream.ts'
+import type { AssistantEventNormalizer, StreamFoldOptions } from '../src/stream.ts'
+import type { StreamChunk } from '@deepseek-ai/dsh-llm'
+
+function usage(input = 0, output = 0): Usage {
+  return { input, output, cacheRead: 0, cacheWrite: 0, totalTokens: input + output }
+}
+
+function assistant(overrides: Partial<AssistantMessage> = {}): AssistantMessage {
+  return {
+    role: 'assistant',
+    content: [],
+    api: 'openai-completions',
+    provider: 'glm',
+    model: 'glm-5.3',
+    usage: usage(),
+    stopReason: 'stop',
+    timestamp: 0,
+    ...overrides,
+  }
+}
+
+async function* feed(...events: AssistantMessageEvent[]): AsyncGenerator<AssistantMessageEvent> {
+  for (const event of events) yield event
+}
+
+async function collect(stream: AsyncIterable<StreamChunk>): Promise<StreamChunk[]> {
+  const out: StreamChunk[] = []
+  for await (const chunk of stream) out.push(chunk)
+  return out
+}
+
+/** Run one stream through the seam with explicit fold options. */
+function translate(events: AsyncGenerator<AssistantMessageEvent>, folds?: StreamFoldOptions) {
+  return collect(toStreamChunks(events, undefined, undefined, undefined, folds))
+}
+
+/** A caller-supplied seam normalizer: uppercases text deltas, everything else passes. */
+const uppercaseDeltas: AssistantEventNormalizer = events => ({
+  async *[Symbol.asyncIterator]() {
+    for await (const event of events) {
+      yield event.type === 'text_delta' ? { ...event, delta: event.delta.toUpperCase() } : event
+    }
+  },
+})
+
+const blockEnds = (chunks: StreamChunk[]): StreamChunk[] => chunks.filter(chunk => chunk.type === 'block-end')
+const textDeltas = (chunks: StreamChunk[]): StreamChunk[] => chunks.filter(chunk => chunk.type === 'text-delta')
+
+/** The GLM gateway quirk: a short prefix block, then the complete answer. */
+const COMPLETE = '这是中转站返回的完整回答，内容足够长，应该只显示一次。'
+
+function gatewayQuirk(): AsyncGenerator<AssistantMessageEvent> {
+  return feed(
+    { type: 'start', partial: assistant() },
+    { type: 'text_start', contentIndex: 0, partial: assistant() },
+    { type: 'text_delta', contentIndex: 0, delta: '这是', partial: assistant() },
+    { type: 'text_end', contentIndex: 0, content: '这是', partial: assistant() },
+    { type: 'text_start', contentIndex: 1, partial: assistant() },
+    { type: 'text_end', contentIndex: 1, content: COMPLETE, partial: assistant() },
+    { type: 'done', reason: 'stop', message: assistant({ content: [{ type: 'text', text: COMPLETE }] }) },
+  )
+}
+
+/** A short block followed by a long unrelated one (the stub-replay rule). */
+function stubThenAnswer(): AsyncGenerator<AssistantMessageEvent> {
+  return feed(
+    { type: 'start', partial: assistant() },
+    { type: 'text_start', contentIndex: 0, partial: assistant() },
+    { type: 'text_delta', contentIndex: 0, delta: 'stub', partial: assistant() },
+    { type: 'text_end', contentIndex: 0, content: 'stub', partial: assistant() },
+    { type: 'text_start', contentIndex: 1, partial: assistant() },
+    { type: 'text_end', contentIndex: 1, content: 'x'.repeat(64), partial: assistant() },
+    { type: 'done', reason: 'stop', message: assistant() },
+  )
+}
+
+/** Two short blocks that the fold must leave alone. */
+function twoShortBlocks(): AsyncGenerator<AssistantMessageEvent> {
+  return feed(
+    { type: 'start', partial: assistant() },
+    { type: 'text_start', contentIndex: 0, partial: assistant() },
+    { type: 'text_end', contentIndex: 0, content: 'short', partial: assistant() },
+    { type: 'text_start', contentIndex: 1, partial: assistant() },
+    { type: 'text_end', contentIndex: 1, content: 'complete answer', partial: assistant() },
+    { type: 'done', reason: 'stop', message: assistant() },
+  )
+}
+
+describe('GLM fold gating', () => {
+  it('folds the gateway short-prefix block into the later complete text for the glm route', async () => {
+    const chunks = await translate(gatewayQuirk(), { provider: 'glm' })
+    expect(blockEnds(chunks)).toEqual([
+      { type: 'block-end', index: 0, block: { type: 'text', text: COMPLETE } },
+    ])
+  })
+
+  it('applies the same fold to a glm-aliased route when a profile says so', async () => {
+    const chunks = await translate(stubThenAnswer(), { provider: 'glm-gateway', applyGlmNormalizer: true })
+    expect(blockEnds(chunks)).toEqual([
+      { type: 'block-end', index: 0, block: { type: 'text', text: 'x'.repeat(64) } },
+    ])
+  })
+
+  it('can explicitly disable the built-in fold', async () => {
+    const chunks = await translate(twoShortBlocks(), { provider: 'glm', applyGlmNormalizer: false })
+    expect(blockEnds(chunks)).toHaveLength(2)
+  })
+
+  it('does not apply the fold to another provider', async () => {
+    const chunks = await translate(twoShortBlocks(), { provider: 'easy' })
+    expect(blockEnds(chunks)).toHaveLength(2)
+  })
+})
+
+describe('caller-supplied normalizers', () => {
+  it('compose after the built-in GLM fold', async () => {
+    const chunks = await translate(gatewayQuirk(), { provider: 'glm', normalizers: [uppercaseDeltas] })
+    expect(textDeltas(chunks)).toEqual([{ type: 'text-delta', index: 0, text: '这是'.toUpperCase() }])
+    expect(blockEnds(chunks)).toEqual([
+      { type: 'block-end', index: 0, block: { type: 'text', text: COMPLETE } },
+    ])
+  })
+
+  it('run without the built-in fold on an unowned route', async () => {
+    const chunks = await translate(gatewayQuirk(), { provider: 'easy', normalizers: [uppercaseDeltas] })
+    expect(textDeltas(chunks)).toEqual([{ type: 'text-delta', index: 0, text: '这是'.toUpperCase() }])
+    // No fold: the short prefix block and the complete block both survive.
+    expect(blockEnds(chunks)).toHaveLength(2)
+  })
+
+  it('leave an unnormalized stream untouched when no folds are configured', async () => {
+    const chunks = await translate(gatewayQuirk())
+    expect(blockEnds(chunks)).toHaveLength(2)
+  })
+})
+
+describe('stream normalizer profile', () => {
+  interface Materialized {
+    streamNormalizers?: { glm?: { enabled?: boolean; providers?: string[] } }
+  }
+
+  it('defaults the built-in GLM folds to the glm route', () => {
+    const config = Config({}) as Materialized
+    expect(config.streamNormalizers?.glm).toEqual({ enabled: true, providers: ['glm'] })
+    const configured = Config({ streamNormalizers: { glm: {} } }) as Materialized
+    expect(configured.streamNormalizers?.glm).toEqual({ enabled: true, providers: ['glm'] })
+  })
+
+  it('allows disabling or aliasing the built-in folds', () => {
+    expect(Config({ streamNormalizers: { glm: { enabled: false, providers: [] } } })).toMatchObject({
+      streamNormalizers: { glm: { enabled: false, providers: [] } },
+    })
+    expect(Config({ streamNormalizers: { glm: { providers: ['glm-gateway'] } } })).toMatchObject({
+      streamNormalizers: { glm: { enabled: true, providers: ['glm-gateway'] } },
+    })
+  })
+})
