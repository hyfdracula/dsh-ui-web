+import { describe, expect, it } from 'vitest'
+import {
+  chainStreamNormalizers,
+  glmTextFold,
+  normalizeGlmTextEvents,
+} from '../src/index.ts'
+import type { StreamEventNormalizer } from '../src/index.ts'
+
+/** A minimal pi-ai-shaped event carrying the fields the fold reads, plus an opaque extra field. */
+type TestEvent =
+  | { type: 'text_start'; contentIndex: number; extra: number }
+  | { type: 'text_delta'; contentIndex: number; delta: string; extra: number }
+  | { type: 'text_end'; contentIndex: number; content: string; extra: number }
+  | { type: 'toolcall_start'; contentIndex: number; extra: number }
+  | { type: 'thinking_start'; contentIndex: number; extra: number }
+  | { type: 'start' }
+  | { type: 'done'; reason: string }
+  | { type: 'error'; reason: string }
+
+const text = (
+  type: 'text_start' | 'text_delta' | 'text_end',
+  contentIndex: number,
+  value: string,
+): TestEvent => {
+  switch (type) {
+    case 'text_start': return { type, contentIndex, extra: 7 }
+    case 'text_delta': return { type, contentIndex, delta: value, extra: 7 }
+    case 'text_end': return { type, contentIndex, content: value, extra: 7 }
+  }
+}
+
+const tool = (contentIndex: number): TestEvent => ({ type: 'toolcall_start', contentIndex, extra: 7 })
+
+async function* feed(...events: TestEvent[]): AsyncGenerator<TestEvent> {
+  for (const event of events) yield event
+}
+
+async function collect<E extends { type: string }>(stream: AsyncIterable<E>): Promise<E[]> {
+  const out: E[] = []
+  for await (const event of stream) out.push(event)
+  return out
+}
+
+describe('normalizeGlmTextEvents', () => {
+  it('folds a short-prefix block into the later complete text block', async () => {
+    const complete = '这是中转站返回的完整回答，内容足够长，应该只显示一次。'
+    const events = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, '这是'),
+      text('text_end', 0, '这是'),
+      text('text_start', 1, ''),
+      text('text_end', 1, complete),
+    )))
+    expect(events).toEqual([
+      text('text_start', 0, ''),
+      text('text_delta', 0, '这是'),
+      { type: 'text_end', contentIndex: 0, content: complete, extra: 7 },
+    ])
+  })
+
+  it('folds a short stub into a long later block even without a prefix match', async () => {
+    const events = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'x'),
+      text('text_end', 0, 'x'),
+      text('text_start', 1, ''),
+      text('text_end', 1, 'y'.repeat(64)),
+    )))
+    expect(events.filter(event => event.type === 'text_end')).toEqual([
+      { type: 'text_end', contentIndex: 0, content: 'y'.repeat(64), extra: 7 },
+    ])
+  })
+
+  it('does not fold two distinct short blocks', async () => {
+    const events = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'alpha'),
+      text('text_end', 0, 'alpha'),
+      text('text_start', 1, ''),
+      text('text_delta', 1, 'beta'),
+      text('text_end', 1, 'beta'),
+    )))
+    expect(events).toEqual([
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'alpha'),
+      text('text_end', 0, 'alpha'),
+      text('text_start', 1, ''),
+      text('text_delta', 1, 'beta'),
+      text('text_end', 1, 'beta'),
+    ])
+  })
+
+  it('does not fold into an already-closed block', async () => {
+    const events = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'hi'),
+      text('text_end', 0, 'hi'),
+      text('text_start', 1, ''),
+      text('text_delta', 1, 'hi there'),
+      text('text_end', 1, 'hi there'),
+      text('text_start', 2, ''),
+      text('text_delta', 2, 'hi there again'),
+      text('text_end', 2, 'hi there again'),
+    )))
+    expect(events).toEqual([
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'hi'),
+      { type: 'text_end', contentIndex: 0, content: 'hi there', extra: 7 },
+      text('text_start', 2, ''),
+      text('text_delta', 2, 'hi there again'),
+      text('text_end', 2, 'hi there again'),
+    ])
+  })
+
+  it('passes non-text events through unchanged, in order', async () => {
+    const events = await collect(normalizeGlmTextEvents(feed(
+      { type: 'start' },
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'a'),
+      text('text_end', 0, 'a'),
+      { type: 'done', reason: 'stop' },
+    )))
+    expect(events).toEqual([
+      { type: 'start' },
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'a'),
+      text('text_end', 0, 'a'),
+      { type: 'done', reason: 'stop' },
+    ])
+  })
+
+  it('flushes a pending text end before a terminal done event', async () => {
+    // Regression: a single non-folded block ends with text_end, then done. A
+    // stream translator stops at the terminal event, so the fold must emit the
+    // pending text_end first or the block assembler never closes the block.
+    const events = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'plain'),
+      text('text_end', 0, 'plain'),
+      { type: 'done', reason: 'stop' },
+    )))
+    expect(events).toEqual([
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'plain'),
+      text('text_end', 0, 'plain'),
+      { type: 'done', reason: 'stop' },
+    ])
+  })
+
+  it('flushes a pending text end before a terminal error event', async () => {
+    const events = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'plain'),
+      text('text_end', 0, 'plain'),
+      { type: 'error', reason: 'boom' },
+    )))
+    expect(events).toEqual([
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'plain'),
+      text('text_end', 0, 'plain'),
+      { type: 'error', reason: 'boom' },
+    ])
+  })
+
+  it('replays a held later block in order when it does not fold', async () => {
+    const events = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'alpha'),
+      text('text_end', 0, 'alpha'),
+      text('text_start', 1, ''),
+      text('text_delta', 1, 'beta'),
+      text('text_end', 1, 'beta'),
+    )))
+    expect(events).toEqual([
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'alpha'),
+      text('text_end', 0, 'alpha'),
+      text('text_start', 1, ''),
+      text('text_delta', 1, 'beta'),
+      text('text_end', 1, 'beta'),
+    ])
+  })
+
+  it('flushes pending text ends before a tool-call or thinking block', async () => {
+    const events = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'alpha'),
+      text('text_end', 0, 'alpha'),
+      text('text_start', 1, ''),
+      text('text_delta', 1, 'beta'),
+      text('text_end', 1, 'beta'),
+      tool(2),
+      { type: 'thinking_start', contentIndex: 3, extra: 7 },
+    )))
+    expect(events.map(event => event.type)).toEqual([
+      'text_start', 'text_delta', 'text_end',
+      'text_start', 'text_delta', 'text_end',
+      'toolcall_start', 'thinking_start',
+    ])
+  })
+
+  it('flushes pending text ends in index order at end of stream', async () => {
+    const events = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_end', 0, 'a'),
+      text('text_start', 1, ''),
+      text('text_end', 1, 'b'),
+      text('text_start', 2, ''),
+      text('text_end', 2, 'c'),
+    )))
+    expect(events).toEqual([
+      text('text_start', 0, ''),
+      text('text_end', 0, 'a'),
+      text('text_start', 1, ''),
+      text('text_end', 1, 'b'),
+      text('text_start', 2, ''),
+      text('text_end', 2, 'c'),
+    ])
+  })
+
+  it('keeps an empty earlier block separate from a later block', async () => {
+    const events = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_end', 0, ''),
+      text('text_start', 1, ''),
+      text('text_delta', 1, 'hello'),
+      text('text_end', 1, 'hello'),
+    )))
+    expect(events).toEqual([
+      text('text_start', 0, ''),
+      text('text_end', 0, ''),
+      text('text_start', 1, ''),
+      text('text_delta', 1, 'hello'),
+      text('text_end', 1, 'hello'),
+    ])
+  })
+
+  it('yields nothing for an empty stream', async () => {
+    await expect(collect(normalizeGlmTextEvents(feed()))).resolves.toEqual([])
+  })
+
+  it('preserves extra fields on rewritten text_end events', async () => {
+    const events = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'hi'),
+      text('text_end', 0, 'hi'),
+      text('text_start', 1, ''),
+      text('text_end', 1, 'hi complete'),
+    )))
+    expect(events.at(-1)).toEqual({ type: 'text_end', contentIndex: 0, content: 'hi complete', extra: 7 })
+  })
+})
+
+describe('glmTextFold', () => {
+  it('is the same transform as normalizeGlmTextEvents', async () => {
+    const complete = 'complete answer with enough length to matter here'
+    const direct = await collect(normalizeGlmTextEvents(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'short'),
+      text('text_end', 0, 'short'),
+      text('text_start', 1, ''),
+      text('text_end', 1, complete),
+    )))
+    const folded = await collect(glmTextFold(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'short'),
+      text('text_end', 0, 'short'),
+      text('text_start', 1, ''),
+      text('text_end', 1, complete),
+    )))
+    expect(folded).toEqual(direct)
+  })
+})
+
+describe('chainStreamNormalizers', () => {
+  const marker = (
+    name: string,
+    order: string[],
+  ): StreamEventNormalizer<TestEvent> => events => ({
+    async *[Symbol.asyncIterator]() {
+      for await (const event of events) {
+        order.push(`${name}:${event.type}`)
+        yield event
+      }
+    },
+  })
+
+  it('applies normalizers in argument order', async () => {
+    const order: string[] = []
+    const events = await collect(chainStreamNormalizers(
+      marker('first', order),
+      marker('second', order),
+      glmTextFold,
+    )(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'hi'),
+      text('text_end', 0, 'hi'),
+      text('text_start', 1, ''),
+      text('text_end', 1, 'hi there'),
+      { type: 'done', reason: 'stop' },
+    )))
+    // Folded: only the complete text block survives as a text_end.
+    expect(events.filter(event => event.type === 'text_end')).toEqual([
+      { type: 'text_end', contentIndex: 0, content: 'hi there', extra: 7 },
+    ])
+    expect(order).toEqual([
+      'first:text_start', 'second:text_start',
+      'first:text_delta', 'second:text_delta',
+      'first:text_end', 'second:text_end',
+      'first:text_start', 'second:text_start',
+      'first:text_end', 'second:text_end',
+      'first:done', 'second:done',
+    ])
+  })
+
+  it('is the identity transform with no normalizers', async () => {
+    const events = await collect(chainStreamNormalizers<TestEvent>()(feed(
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'a'),
+      text('text_end', 0, 'a'),
+    )))
+    expect(events).toEqual([
+      text('text_start', 0, ''),
+      text('text_delta', 0, 'a'),
+      text('text_end', 0, 'a'),
+    ])
+  })
+})
