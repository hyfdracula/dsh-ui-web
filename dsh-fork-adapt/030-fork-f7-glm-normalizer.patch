@@ -0,0 +1,292 @@
+/**
+ * GLM OpenAI-Responses gateway stream folding.
+ *
+ * The GLM gateway has a known streaming quirk: it may open a short text block,
+ * then emit a later text block containing the complete answer. Without
+ * normalization an assembler would retain the short prefix AND the complete
+ * answer as two visible blocks. This package folds the later block's end back
+ * onto the earlier index so only the complete text survives.
+ *
+ * The fold operates on a **structural** subset of pi-ai assistant events: it
+ * reads only `type`, `contentIndex`, `delta`, and `content`, and passes every
+ * other event through unchanged. Any pi-ai-shaped event stream (or a
+ * structural twin from another provider) can be normalized without importing
+ * pi-ai. The `glmTextFold` normalizer composes through
+ * {@link chainStreamNormalizers}, so a stream translator can chain provider
+ * quirks without owning their implementations.
+ *
+ * This is a **library, not a service or plugin**: no `ctx`, registers nothing,
+ * emits no events. The pi-ai adapter (`dsh-llm-pi-ai`) applies the fold for
+ * its `glm` provider route.
+ *
+ * @module @deepseek-ai/dsh-llm-glm-normalize
+ */
+
+/** The minimum shape every event carries: a string `type` discriminator. */
+export interface StreamEventLike {
+  type: string
+}
+
+/**
+ * Pluggable per-provider stream-normalizer registry that this package owns. The
+ * pi-ai adapter reads `normalizersFor(provider)`; when a provider has
+ * registered normalizers they supersede the built-in GLM fold for that route
+ * (so this package owns the whole GLM normalization story, and a plugin or the
+ * profile can register/replace it without double-folding). Module-scoped: one
+ * host process owns one registry, the single-deployment posture this seam
+ * targets.
+ */
+const registeredNormalizers = new Map<string, StreamEventNormalizer[]>()
+
+/**
+ * Register (or replace) the stream normalizers for one provider route.
+ * @param provider - provider route key.
+ * @param normalizers - normalizers applied in order for that route.
+ */
+export function registerStreamNormalizer(provider: string, ...normalizers: StreamEventNormalizer[]): void {
+  registeredNormalizers.set(provider, normalizers)
+}
+
+/** The normalizers registered for a provider, or `undefined` when none own it. */
+export function normalizersFor(provider: string): StreamEventNormalizer[] | undefined {
+  return registeredNormalizers.get(provider)
+}
+
+/**
+ * A stream normalizer is one `(events) => AsyncIterable<E>` stage in the pi-ai
+ * assistant event pipeline. This package ships the GLM gateway folds; the
+ * `glmNormalize` plugin entry (below) registers them for the `glm` route so the
+ * pi-ai adapter composes them.
+ */
+export type StreamEventNormalizer<E extends StreamEventLike = StreamEventLike> =
+  (events: AsyncIterable<E>) => AsyncIterable<E>
+
+/** The event shapes the fold inspects; everything else passes through. */
+type GlmTextShape =
+  | { type: 'text_start'; contentIndex: number }
+  | { type: 'text_delta'; contentIndex: number; delta: string }
+  | { type: 'text_end'; contentIndex: number; content: string }
+  | { type: 'toolcall_start' | 'thinking_start'; contentIndex: number }
+
+/** A `text_end` event, the only shape the fold rewrites. */
+type GlmTextEnd = Extract<GlmTextShape, { type: 'text_end' }>
+
+/**
+ * Narrow an arbitrary event to the shapes the fold inspects, or `undefined`
+ * for a pass-through event.
+ * @param event - any stream event.
+ * @returns the fold's view of the event, or `undefined` to pass it through.
+ */
+function asGlmTextShape(event: StreamEventLike): GlmTextShape | undefined {
+  switch (event.type) {
+    case 'text_start':
+    case 'text_delta':
+    case 'text_end':
+    case 'toolcall_start':
+    case 'thinking_start':
+      return event as GlmTextShape
+    default:
+      return undefined
+  }
+}
+
+/**
+ * Normalize the known GLM OpenAI-Responses gateway quirk: it may start a short
+ * text block, then emit a later text block containing the complete answer. The
+ * later block is folded back into the earlier index so the assembler cannot
+ * retain the short prefix and complete answer as two visible blocks.
+ *
+ * Folding rule at `text_end`: the later block folds onto an earlier unclosed
+ * block with non-empty accumulated text when the later content starts with
+ * that prefix, OR the prefix is at most 16 characters and the later content is
+ * at least 64 characters (a long replay of a stub the gateway truncated).
+ * A later text block opened before the earlier one closes is held until its
+ * `text_end` decides, so tool-call and thinking order stay unchanged.
+ * Pending text ends flush before any tool-call or thinking block, before a
+ * terminal `done`/`error` event, and at end of stream — no text block is ever
+ * left open by a stream that stops translating at the terminal event.
+ *
+ * @param events - one assistant event stream.
+ * @returns events with a cumulative text block folded into its earlier block.
+ */
+export async function* normalizeGlmTextEvents<E extends StreamEventLike>(
+  events: AsyncIterable<E>,
+): AsyncGenerator<E> {
+  const buffers = new Map<number, string>()
+  const closed = new Set<number>()
+  const pendingEnds = new Map<number, GlmTextEnd>()
+  const held = new Map<number, GlmTextShape[]>()
+
+  const flushPending = function* (): Generator<E> {
+    for (const index of [...pendingEnds.keys()].sort((a, b) => a - b)) {
+      const end = pendingEnds.get(index)
+      if (end !== undefined) yield end as unknown as E
+      pendingEnds.delete(index)
+      closed.add(index)
+      buffers.delete(index)
+    }
+  }
+
+  for await (const raw of events) {
+    const event = asGlmTextShape(raw)
+    if (event === undefined) {
+      // A terminal event must never precede an unflushed text end: the stream
+      // translator stops at `done`/`error`, so a pending end left behind would
+      // never reach the block assembler and the last text block would stay
+      // open forever. Flush pending ends first, in index order.
+      if (raw.type === 'done' || raw.type === 'error') yield* flushPending()
+      yield raw
+      continue
+    }
+    switch (event.type) {
+      case 'text_start':
+        // GLM may open another text block before closing the earlier short block.
+        // Hold the later block until its text_end reveals whether it is the full
+        // answer replayed by the gateway. A new non-text block flushes pending
+        // text first so tool-call order stays unchanged.
+        {
+          const priorOpen = [...buffers.entries()].some(([index, text]) => (
+            index < event.contentIndex && !closed.has(index) && text.length > 0
+          ))
+          if (priorOpen || pendingEnds.size > 0) held.set(event.contentIndex, [event])
+          else yield* flushPending()
+          if (!priorOpen && pendingEnds.size === 0) yield event as unknown as E
+          buffers.set(event.contentIndex, '')
+          continue
+        }
+      case 'toolcall_start':
+      case 'thinking_start':
+        yield* flushPending()
+        yield event as unknown as E
+        continue
+      case 'text_delta':
+        buffers.set(event.contentIndex, `${buffers.get(event.contentIndex) ?? ''}${event.delta}`)
+        {
+          const queued = held.get(event.contentIndex)
+          if (queued !== undefined) queued.push(event)
+          else yield event as unknown as E
+        }
+        continue
+      case 'text_end':
+        {
+          const prior = [...buffers.entries()].find(([index, prefix]) => (
+            index < event.contentIndex && !closed.has(index) && prefix.length > 0
+              && (event.content.startsWith(prefix) || (prefix.length <= 16 && event.content.length >= 64))
+          ))
+          if (prior !== undefined) {
+            const [index] = prior
+            // block-end is authoritative in BlockAssembler: replace the short
+            // prefix with the complete text and do not publish the later block.
+            yield { ...event, contentIndex: index } as unknown as E
+            closed.add(index)
+            buffers.delete(index)
+            pendingEnds.delete(index)
+            held.delete(event.contentIndex)
+            buffers.delete(event.contentIndex)
+            continue
+          }
+          yield* flushPending()
+          const queued = held.get(event.contentIndex)
+          if (queued !== undefined) {
+            for (const queuedEvent of queued) yield queuedEvent as unknown as E
+            held.delete(event.contentIndex)
+          }
+          pendingEnds.set(event.contentIndex, event)
+          continue
+        }
+    }
+  }
+  yield* flushPending()
+}
+
+/**
+ * The GLM gateway fold as a composable {@link StreamEventNormalizer}: identity
+ * on the event type, `normalizeGlmTextEvents` underneath.
+ */
+export function glmTextFold<E extends StreamEventLike>(events: AsyncIterable<E>): AsyncIterable<E> {
+  return normalizeGlmTextEvents(events)
+}
+
+/** Structural view of the pi-ai terminal events this fold inspects. */
+type TerminalEvent<E> = E & {
+  type: 'done' | 'error'
+  reason?: string
+  message?: { content?: unknown[]; stopReason?: string; errorMessage?: string; usage?: unknown }
+  error?: { content?: unknown[]; stopReason?: string; errorMessage?: string; usage?: unknown }
+}
+
+/**
+ * GLM (Vectide `muse-spark` backend) terminal-event fold. The gateway ends a
+ * stream with `[DONE]` but never emits a terminal `finish_reason` chunk, which
+ * pi-ai surfaces as an `error` event whose message is "Stream ended without
+ * finish_reason". The response is complete — the content blocks were already
+ * delivered — so this normalizer rewrites that benign `error` into a normal
+ * `done`/`stop` as long as content was produced; a genuinely empty or
+ * truncated stream still surfaces as an error.
+ *
+ * @param events - one assistant event stream.
+ * @returns events with the benign missing-finish_reason error folded to stop.
+ */
+export async function* glmTerminalFold<E extends StreamEventLike>(events: AsyncIterable<E>): AsyncGenerator<E> {
+  for await (const raw of events) {
+    const event = raw as TerminalEvent<E>
+    if (event.type !== 'error') {
+      yield raw
+      continue
+    }
+    const msg = event.error ?? event.message
+    const text = msg?.errorMessage ?? ''
+    if (/\bStream ended without finish_reason\b/i.test(text) && (msg?.content?.length ?? 0) > 0) {
+      // Rewrite as a completed stop, preserving usage/content for translation.
+      yield { type: 'done', reason: 'stop', message: { ...msg, stopReason: 'stop' } } as unknown as E
+      continue
+    }
+    yield raw
+  }
+}
+
+/**
+ * Compose stream normalizers into one: each stage sees the stream the previous
+ * stage produced, applied in argument order. With no normalizers this is the
+ * identity transform.
+ * @param normalizers - normalizers applied in order.
+ * @returns one normalizer equivalent to the whole chain.
+ */
+export function chainStreamNormalizers<E extends StreamEventLike>(
+  ...normalizers: StreamEventNormalizer<E>[]
+): StreamEventNormalizer<E> {
+  return (events) => normalizers.reduce(
+    (current, normalizer) => normalizer(current),
+    events,
+  )
+}
+
+// ---------------------------------------------------------------------------
+// Cordis plugin entry: registers the GLM gateway normalization (cumulative-text
+// fold + missing-finish_reason terminal fold) for the `glm` route so the pi-ai
+// adapter composes them. Registering this plugin in a profile makes GLM
+// normalization an installable/removable unit; without it the adapter keeps
+// only the built-in text fold and does not apply the terminal fold.
+// ---------------------------------------------------------------------------
+
+import type { Context } from '@deepseek-ai/cordis'
+
+/** Plugin configuration. */
+export interface Config {
+  /** Provider routes on which the GLM normalization registers; defaults to `['glm']`. */
+  providers?: string[]
+}
+
+export const name = 'glm-normalize'
+
+export const inject = [] as const
+
+export function apply(_ctx: Context, config?: Config): void {
+  for (const provider of config?.providers ?? ['glm']) {
+    registerStreamNormalizer(
+      provider,
+      glmTextFold as StreamEventNormalizer,
+      glmTerminalFold as StreamEventNormalizer,
+    )
+  }
+}
