-' DSH quick-send bridge.
-' wscript.exe (GUI subsystem) starts the WinForms dialog through PowerShell with
-' window style 0, so no console window flashes next to the dialog.
-'
-' Usage:
-'   wscript.exe dsh-quick-send.vbs
-'   (the restart worker launches exactly this after a restart)
-
-Option Explicit
-
-Dim shell, cmd
-Set shell = CreateObject("WScript.Shell")
-cmd = "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File ""C:\Users\19161\deepseek-harness-next\dsh-quick-send.ps1"""
-shell.Run cmd, 0, False
