diff --git a/packages/client/ui-turn-recovery/tests/continue-panel.client.spec.tsx b/packages/client/ui-turn-recovery/tests/continue-panel.client.spec.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..921e58360d01f25d69892ff0754f25a35466965b
--- /dev/null
+++ b/packages/client/ui-turn-recovery/tests/continue-panel.client.spec.tsx
@@ -0,0 +1,129 @@
+// @vitest-environment jsdom
+// Interrupted-turn recovery tests: the chain selector elects only an
+// interrupted Turn, and the panel sends one continuation on an explicit click
+// — never twice, never while the live queue already holds one.
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import type { ReactNode } from 'react'
+import { ContinuePanel } from '../src/client/ContinuePanel.tsx'
+import type { ContinuePanelProps } from '../src/client/ContinuePanel.tsx'
+import { selectInterruptedTurn } from '../src/client/index.ts'
+import { CONTINUE_PROMPT, continuationAlreadyRequested } from '../src/client/continue-policy.ts'
+import { en, zh } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+function translate(key: string, params?: Record<string, unknown>): string {
+  const value = (zh as Record<string, string>)[key] ?? (en as Record<string, string>)[key] ?? key
+  return value.replace(/\{([^}]+)\}/g, (_, name: string) => String(params?.[name] ?? `{${name}}`))
+}
+
+/** One closing-Turn owner for the chain selector. */
+function owner(reason: { kind: string } | undefined): Parameters<typeof selectInterruptedTurn>[0] {
+  return {
+    turn: {
+      turn: 3,
+      start: undefined,
+      end: reason === undefined ? undefined : ({ data: { turn: 3, reason } } as never),
+      status: 'closed',
+      steps: [],
+      data: {} as never,
+    },
+    seq: 12,
+    openFile: () => {},
+  } as never
+}
+
+/** A live session snapshot with no queued continuation and no running turn. */
+function idleSnapshot(overrides: Partial<{ running: boolean; texts: (string | null)[] }> = {}) {
+  return {
+    running: overrides.running ?? false,
+    queue: (overrides.texts ?? []).map(text => ({ text })),
+  } as never
+}
+
+function bench(over: {
+  continueInterrupted?: (sessionId: string) => Promise<void>
+  snapshot?: unknown
+} = {}) {
+  const continueInterrupted = vi.fn(over.continueInterrupted ?? (async () => {}))
+  const snapshot = over.snapshot ?? idleSnapshot()
+  const props = {
+    matched: { turn: 3 },
+    sessionId: 's-1',
+    useSession: ((selector: (value: unknown) => unknown) => selector(snapshot)) as never,
+    continueInterrupted,
+    t: translate,
+  } as unknown as ContinuePanelProps
+  const view = render(<ContinuePanel {...props} /> as ReactNode)
+  return { view, continueInterrupted }
+}
+
+describe('selectInterruptedTurn', () => {
+  it('elects a Turn whose durable closer says interrupted', () => {
+    expect(selectInterruptedTurn(owner({ kind: 'interrupted' }))).toEqual({ turn: 3 })
+  })
+
+  it('declines every other closer, and an open Turn', () => {
+    expect(selectInterruptedTurn(owner({ kind: 'completed' }))).toBeNull()
+    expect(selectInterruptedTurn(owner({ kind: 'aborted' }))).toBeNull()
+    expect(selectInterruptedTurn(owner({ kind: 'error' }))).toBeNull()
+    expect(selectInterruptedTurn(owner(undefined))).toBeNull()
+  })
+})
+
+describe('continuationAlreadyRequested', () => {
+  it('is true while a turn runs or the continuation still sits in the queue', () => {
+    expect(continuationAlreadyRequested(idleSnapshot())).toBe(false)
+    expect(continuationAlreadyRequested(idleSnapshot({ running: true }))).toBe(true)
+    expect(continuationAlreadyRequested(idleSnapshot({ texts: [CONTINUE_PROMPT] }))).toBe(true)
+    expect(continuationAlreadyRequested(idleSnapshot({ texts: ['something else'] }))).toBe(false)
+  })
+})
+
+describe('turn-recovery ContinuePanel', () => {
+  it('offers Continue and sends exactly once on rapid re-click', () => {
+    const { continueInterrupted } = bench()
+    const button = screen.getByRole('button', { name: '继续任务' })
+    fireEvent.click(button)
+    fireEvent.click(button)
+    expect(continueInterrupted).toHaveBeenCalledTimes(1)
+    expect(continueInterrupted).toHaveBeenCalledWith('s-1')
+  })
+
+  it('does not send again while the request is in flight', () => {
+    let resolve!: () => void
+    bench({ continueInterrupted: () => new Promise<void>(r => { resolve = r }) })
+    fireEvent.click(screen.getByRole('button', { name: '继续任务' }))
+    const button = screen.getByRole('button', { name: '正在继续…' })
+    expect(button.hasAttribute('disabled')).toBe(true)
+    fireEvent.click(button)
+    expect(screen.getByRole('alert').textContent).toContain('上次任务被中断')
+    act(() => { resolve() })
+  })
+
+  it('withdraws Continue after success while keeping the hint', async () => {
+    bench()
+    fireEvent.click(screen.getByRole('button', { name: '继续任务' }))
+    await vi.waitFor(() => {
+      expect(screen.queryByRole('button', { name: '继续任务' })).toBeNull()
+    })
+    expect(screen.getByRole('alert').textContent).toContain('上次任务被中断，已恢复上下文')
+  })
+
+  it('reports localized failure and keeps the button for retry', async () => {
+    bench({ continueInterrupted: () => Promise.reject(new Error('boom')) })
+    fireEvent.click(screen.getByRole('button', { name: '继续任务' }))
+    await vi.waitFor(() => {
+      expect(screen.getByRole('alert').textContent).toContain('继续任务失败：boom')
+    })
+    expect(screen.getByRole('button', { name: '继续任务' })).not.toBeNull()
+  })
+
+  it('hides Continue when the live queue already holds a continuation', () => {
+    bench({ snapshot: idleSnapshot({ texts: [CONTINUE_PROMPT] }) })
+    expect(screen.queryByRole('button', { name: '继续任务' })).toBeNull()
+    expect(screen.getByRole('alert').textContent).toContain('上次任务被中断')
+  })
+})
