@@ -0,0 +1,78 @@
+/**
+ * The interrupted-turn continuation panel.
+ *
+ * Rendered by the Chat's `conversation.chat.turnTail` chain for a Turn whose
+ * durable closer says `interrupted`. The panel never continues on its own: it
+ * states the situation and queues one fixed continuation prompt on an explicit
+ * click, guarding against a duplicate send while the click is in flight and
+ * while the continuation already sits in the session's queue.
+ */
+import { memo, useState } from 'react'
+import { Button } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { InjectFace, PropsLocale, SessionStandardProps } from '@deepseek-ai/dsh-client-ui-slots'
+import type { TurnTailOwnerProps } from '@deepseek-ai/dsh-client-ui-chat/client'
+import type { TurnRecoveryInjected } from './index.ts'
+import { continuationAlreadyRequested } from './continue-policy.ts'
+import css from './ContinuePanel.module.css'
+
+/** Selector payload handed to the panel by the chain election. */
+export interface TurnRecoveryMatch {
+  /** Durable turn number that ended interrupted. */
+  turn: number
+}
+
+/**
+ * Full props of the panel: the chain's matched share, the framework's session
+ * seats (identity + live snapshot hook), the injected continuation verb, and
+ * the locale seat.
+ */
+export type ContinuePanelProps = { matched: TurnRecoveryMatch }
+  & Pick<SessionStandardProps, 'sessionId' | 'useSession'>
+  & InjectFace<TurnRecoveryInjected>
+  & PropsLocale<'turn-recovery'>
+
+/** User-confirmed continuation affordance for a persisted interrupted turn. */
+export const ContinuePanel = memo(function ContinuePanel({
+  sessionId, useSession, continueInterrupted, t,
+}: ContinuePanelProps) {
+  const [busy, setBusy] = useState(false)
+  const [requested, setRequested] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+  // Live queue facts: a continuation that is already queued or running keeps
+  // the button hidden even after a remount, so the send cannot be duplicated.
+  const alreadyRequested = useSession(snapshot => continuationAlreadyRequested(snapshot))
+
+  if (requested || alreadyRequested) {
+    return (
+      <div className={css.panel} role="alert">
+        <span>{t('message.interrupted.hint')}</span>
+      </div>
+    )
+  }
+
+  const continueTask = async (): Promise<void> => {
+    if (busy) return
+    setBusy(true)
+    setError(null)
+    try {
+      await continueInterrupted(sessionId)
+      setRequested(true)
+    } catch (cause: unknown) {
+      setError(t('message.interrupted.error', { message: cause instanceof Error ? cause.message : String(cause) }))
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  return (
+    <div className={css.panel} role="alert">
+      <span>{t('message.interrupted.hint')}</span>
+      <Button variant="primary" disabled={busy} onClick={() => { void continueTask() }}>
+        {busy ? t('message.interrupted.continuing') : t('message.interrupted.continue')}
+      </Button>
+      {error === null ? null : <span className={css.error}>{error}</span>}
+    </div>
+  )
+})
+
+export type { TurnTailOwnerProps }
diff --git a/packages/client/ui-turn-recovery/src/client/continue-policy.ts b/packages/client/ui-turn-recovery/src/client/continue-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bea6a1ce55387d51e14ed9ad40aa93f9851a0474
--- /dev/null
+++ b/packages/client/ui-turn-recovery/src/client/continue-policy.ts
@@ -0,0 +1,36 @@
+/**
+ * Continuation-after-interruption policy.
+ *
+ * The interrupted-turn Continue affordance asks the session to queue one fixed
+ * continuation prompt. Queueing is only safe once per interruption: re-clicking
+ * the historical button while the continuation is already queued or running
+ * would enqueue a second autonomous continuation. The panel's own in-flight
+ * state guards rapid double-clicks, but the queue survives it — the prompt can
+ * sit queued (not yet running) while the button re-enables — and a remounted
+ * view forgets local state. This module owns the business predicate that makes
+ * the send itself idempotent.
+ *
+ * Ported from the 0.1.1 fork's `ui-conversation/chat/continue-policy.ts`; the
+ * 0.1.5 client session snapshot carries the same two facts (`running`, and the
+ * pending queue with each row's plain `text`).
+ */
+import type { SessionSnapshot } from '@deepseek-ai/dsh-api-session-controller/client'
+
+/** The user-confirmed continuation prompt sent after an interrupted turn. */
+export const CONTINUE_PROMPT =
+  'The previous task was interrupted by a host restart. Continue from the saved context. Verify completed work and do not blindly repeat side-effecting tool calls.'
+
+/**
+ * Whether a continuation for the interrupted turn is already in flight: the
+ * session is running a turn, or the fixed continuation prompt is still pending
+ * in the queue. Either way another send would duplicate it.
+ * @param snapshot - the scoped session's live snapshot.
+ * @param prompt - the continuation prompt to recognize (tests may substitute).
+ * @returns true when a fresh continuation send must be skipped.
+ */
+export function continuationAlreadyRequested(
+  snapshot: Pick<SessionSnapshot, 'running' | 'queue'>,
+  prompt: string = CONTINUE_PROMPT,
+): boolean {
+  return snapshot.running || snapshot.queue.some(row => row.text === prompt)
+}
