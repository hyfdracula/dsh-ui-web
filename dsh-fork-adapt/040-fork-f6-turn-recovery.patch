+++ b/packages/client/ui-turn-recovery/src/client/index.ts
@@ -0,0 +1,98 @@
+/**
+ * Interrupted-turn recovery presentation plugin.
+ *
+ * A persisted log whose last turn never ended is closed after the fact with a
+ * `turn/end` reason of `interrupted` (agent-loop resume appends the closer; a
+ * cold read synthesizes it). The restored context is complete — the model may
+ * simply continue — so this plugin offers one explicit, user-confirmed
+ * continuation through the Chat's completed-Turn extension chain
+ * (`conversation.chat.turnTail`), never automatically.
+ *
+ * 0.1.5 differences from the 0.1.1 fork this ports: the chain slot moved to
+ * ui-chat and its owner props carry no `interrupted`/`continueInterrupted`; the
+ * selector reads the turn's own `turn/end` reason instead, and the continuation
+ * goes through the session face (`binding.session.prompt`) rather than a
+ * ui-conversation-injected verb, so this stays a single removable plugin.
+ */
+import type { Context as ClientContext } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+// Type-only: pulls `ctx.sessions` (ISessions + SessionFace) and the ui-chat
+// SlotMap merge that declares `conversation.chat.turnTail`.
+import type {} from '@deepseek-ai/dsh-api-session-controller/client'
+import type { TurnTailOwnerProps } from '@deepseek-ai/dsh-client-ui-chat/client'
+import type {} from '@deepseek-ai/dsh-client-ui-chat/client'
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+// Type-only: 0.1.5 declares `ctx.slots` in ui-renderer's Context merge.
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+import { ContinuePanel, type TurnRecoveryMatch } from './ContinuePanel.tsx'
+import { CONTINUE_PROMPT, continuationAlreadyRequested } from './continue-policy.ts'
+import { en, zh, type TurnRecoveryKey } from './locales.ts'
+
+export type { TurnRecoveryKey } from './locales.ts'
+export type { TurnRecoveryMatch } from './ContinuePanel.tsx'
+export { CONTINUE_PROMPT, continuationAlreadyRequested } from './continue-policy.ts'
+
+/** Dictionary namespace owned by this plugin. */
+const NS = 'turn-recovery'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    'turn-recovery': TurnRecoveryKey
+  }
+}
+
+/** Injected business face of the recovery panel. */
+export interface TurnRecoveryInjected {
+  /**
+   * Queue the fixed continuation prompt for one interrupted session.
+   * Idempotent: a running turn or an already-queued continuation is a no-op.
+   * @param sessionId - the session whose interrupted turn is being continued.
+   * @throws when the session is unknown or the host rejects the prompt.
+   */
+  continueInterrupted(sessionId: SessionId): Promise<void>
+}
+
+/** Services required by this plugin. */
+export const inject = ['slots', 'sessions', 'locale']
+
+/**
+ * Elect one closing Turn whose `turn/end` reason is `interrupted`.
+ *
+ * Pure by contract (chain selectors run at render time and must not read
+ * external state): an interrupted turn is a durable fact on the owner.
+ * @param owner - the closing Turn's owner currency.
+ * @returns the match handed to the panel, or null to decline this Turn.
+ */
+export function selectInterruptedTurn(owner: TurnTailOwnerProps): TurnRecoveryMatch | null {
+  const reason = owner.turn.end?.data.reason
+  return reason?.kind === 'interrupted' ? { turn: owner.turn.turn } : null
+}
+
+/**
+ * Register the interrupted-turn continuation panel.
+ * @param ctx - client root context.
+ */
+export function apply(ctx: ClientContext): void {
+  ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'ui-turn-recovery: dictionaries')
+  ctx.slots.inject('conversation.chat.turnTail', () => ctx.slots.register({
+    name: 'conversation.chat.turnTail',
+    select: selectInterruptedTurn,
+    locale: NS,
+    inject: (): TurnRecoveryInjected => ({
+      continueInterrupted: async (sessionId: SessionId): Promise<void> => {
+        const session = ctx.sessions.binding(sessionId)?.session
+        if (session === undefined) {
+          throw new Error(`turn-recovery: session "${sessionId}" is unavailable`)
+        }
+        // Idempotent by live data, not by local state: a remounted panel sees
+        // the same queue and stays quiet instead of queueing a second
+        // autonomous continuation.
+        if (continuationAlreadyRequested(session.getSnapshot())) return
+        const result = await session.prompt([{ type: 'text', text: CONTINUE_PROMPT }], 'queue')
+        if (!result.ok) {
+          throw new Error(`${result.error.code}: ${result.error.message}`)
+        }
+      },
+    }),
+  }, ContinuePanel))
+}
